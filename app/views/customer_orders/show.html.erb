<div class="container mx-auto px-4 py-6">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold text-gray-900">Customer Order: <%= @customer_order.number %></h1>
    <div class="flex space-x-2">
      <% unless @customer_order.voided %>
        <%= link_to "Edit", edit_customer_order_path(@customer_order),
            class: "bg-yellow-500 hover:bg-yellow-700 text-white font-bold py-2 px-4 rounded" %>
        <%= link_to "Add Works Order", new_customer_order_works_order_path(@customer_order),
            class: "bg-green-500 hover:bg-green-700 text-white font-bold py-2 px-4 rounded" %>
        <% if @bookout_candidates.any? %>
          <button type="button"
                  onclick="document.getElementById('bookout-modal').showModal()"
                  class="bg-blue-600 hover:bg-blue-800 text-white font-bold py-2 px-4 rounded">
            Quick Bookout
          </button>
        <% end %>
        <% if @customer_order.delivery_release_notes.any? %>
          <%= link_to "Collection Pack (PDF)",
              collection_pack_customer_order_path(@customer_order, format: :pdf),
              target: "_blank",
              title: "One PDF: the Proof of Collection the driver signs, followed by the Certificate of Conformity for every release note on this order",
              class: "bg-purple-600 hover:bg-purple-800 text-white font-bold py-2 px-4 rounded" %>
        <% end %>
        <% if @customer_order.can_be_voided? %>
          <%= link_to "Void Order", void_customer_order_path(@customer_order),
              method: :patch,
              class: "bg-red-500 hover:bg-red-700 text-white font-bold py-2 px-4 rounded",
              data: { confirm: "Are you sure you want to void this customer order? This cannot be undone." } %>
        <% end %>
      <% end %>
      <%= link_to "Back to Orders", customer_orders_path,
          class: "bg-gray-500 hover:bg-gray-700 text-white font-bold py-2 px-4 rounded" %>
    </div>
  </div>

  <%
    uninvoiced_release_notes = ReleaseNote.joins(:works_order)
                                         .where(works_orders: { customer_order_id: @customer_order.id })
                                         .requires_invoicing

    invoiced_release_notes = ReleaseNote.joins(:works_order)
                                       .where(works_orders: { customer_order_id: @customer_order.id })
                                       .joins(:invoice_item)

    uninvoiced_count = uninvoiced_release_notes.sum(:quantity_accepted)
    invoiced_count = invoiced_release_notes.sum(:quantity_accepted)
    total_released = @customer_order.works_orders.active.sum(:quantity_released)

    uninvoiced_works_orders = @customer_order.works_orders
                                            .joins(:release_notes)
                                            .merge(ReleaseNote.requires_invoicing)
                                            .distinct.count
  %>

  <!-- Invoicing Status Card (read-only; invoicing is actioned from the dashboard worklist) -->
  <% if total_released > 0 %>
    <div class="bg-white border-l-4 <%= uninvoiced_count > 0 ? 'border-orange-400 bg-orange-50' : 'border-green-400 bg-green-50' %> p-6 mb-6 rounded-lg shadow">
      <div class="flex justify-between items-start">
        <div>
          <h2 class="text-xl font-semibold <%= uninvoiced_count > 0 ? 'text-orange-800' : 'text-green-800' %> mb-2">
            Invoicing Status
          </h2>

          <% if uninvoiced_count > 0 %>
            <p class="text-orange-700 mb-3">
              <span class="font-bold"><%= uninvoiced_count %> parts</span> across
              <span class="font-bold"><%= uninvoiced_works_orders %> works order<%= uninvoiced_works_orders == 1 ? '' : 's' %></span>
              are ready to be invoiced.
            </p>

            <div class="text-sm text-orange-600 space-y-1">
              <div>• Uninvoiced release notes: <%= uninvoiced_release_notes.count %></div>
              <% if invoiced_count > 0 %>
                <div>• Previously invoiced: <%= invoiced_count %> parts</div>
              <% end %>
            </div>
          <% else %>
            <p class="text-green-700 mb-3">
              All <span class="font-bold"><%= total_released %> released parts</span> have been invoiced.
            </p>
            <div class="text-sm text-green-600">
              • Total invoiced release notes: <%= invoiced_release_notes.count %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
    <!-- Order Details -->
    <div class="bg-white shadow rounded-lg p-6">
      <h2 class="text-xl font-semibold text-gray-900 mb-4">Order Details</h2>

      <dl class="space-y-3">
        <div>
          <dt class="text-sm font-medium text-gray-500">Customer</dt>
          <dd class="text-sm text-gray-900"><%= @customer_order.customer.name %></dd>
        </div>

        <div>
          <dt class="text-sm font-medium text-gray-500">Order Number</dt>
          <dd class="text-sm text-gray-900"><%= @customer_order.number %></dd>
        </div>

        <div>
          <dt class="text-sm font-medium text-gray-500">Date Received</dt>
          <dd class="text-sm text-gray-900"><%= @customer_order.date_received.strftime("%d/%m/%Y") %></dd>
        </div>

        <div>
          <dt class="text-sm font-medium text-gray-500">Status</dt>
          <dd class="text-sm">
            <% if @customer_order.voided %>
              <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full bg-red-100 text-red-800">
                Voided
              </span>
            <% elsif @customer_order.outstanding? %>
              <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full bg-yellow-100 text-yellow-800">
                Outstanding
              </span>
            <% else %>
              <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full bg-green-100 text-green-800">
                Complete
              </span>
            <% end %>
          </dd>
        </div>

        <div>
          <dt class="text-sm font-medium text-gray-500">Created By</dt>
          <dd class="text-sm text-gray-900">
            <%= @customer_order.created_by&.display_name || "—" %>
            <span class="text-gray-500">on <%= @customer_order.created_at.strftime("%d/%m/%Y %H:%M") %></span>
          </dd>
        </div>

        <% if @customer_order.updated_by.present? && @customer_order.updated_at > @customer_order.created_at + 1.minute %>
          <div>
            <dt class="text-sm font-medium text-gray-500">Last Updated By</dt>
            <dd class="text-sm text-gray-900">
              <%= @customer_order.updated_by.display_name %>
              <span class="text-gray-500">on <%= @customer_order.updated_at.strftime("%d/%m/%Y %H:%M") %></span>
            </dd>
          </div>
        <% end %>

        <div>
          <dt class="text-sm font-medium text-gray-500">Purchase Order</dt>
          <dd class="text-sm text-gray-900">
            <% if @customer_order.po_attached? %>
              <%= link_to "View PO (PDF)", @customer_order.po_document_url,
                  target: "_blank", class: "text-blue-600 hover:text-blue-900 font-medium" %>
            <% else %>
              <span class="text-gray-400">Not attached</span>
              <% unless @customer_order.voided %>
                — <%= link_to "add one", edit_customer_order_path(@customer_order), class: "text-blue-600 hover:text-blue-900" %>
              <% end %>
            <% end %>
          </dd>
        </div>

      </dl>
    </div>

    <!-- Summary Statistics -->
    <div class="bg-white shadow rounded-lg p-6">
      <h2 class="text-xl font-semibold text-gray-900 mb-4">Order Summary</h2>

      <dl class="space-y-3">
        <div>
          <dt class="text-sm font-medium text-gray-500">Total Works Orders</dt>
          <dd class="text-sm text-gray-900 font-semibold"><%= @customer_order.works_orders.count %></dd>
        </div>

        <div>
          <dt class="text-sm font-medium text-gray-500">Active Works Orders</dt>
          <dd class="text-sm text-gray-900 font-semibold"><%= @customer_order.works_orders.active.count %></dd>
        </div>

        <div>
          <dt class="text-sm font-medium text-gray-500">Open Works Orders</dt>
          <dd class="text-sm text-gray-900 font-semibold <%= @customer_order.works_orders.open.count > 0 ? 'text-orange-600' : 'text-green-600' %>">
            <%= @customer_order.works_orders.open.count %>
          </dd>
        </div>

        <div>
          <dt class="text-sm font-medium text-gray-500">Total Quantity</dt>
          <dd class="text-sm text-gray-900 font-semibold"><%= @customer_order.total_quantity %></dd>
        </div>

        <div>
          <dt class="text-sm font-medium text-gray-500">Total Released</dt>
          <dd class="text-sm text-gray-900 font-semibold <%= total_released > 0 ? 'text-green-600' : 'text-gray-500' %>">
            <%= total_released %>
          </dd>
        </div>

        <div>
          <dt class="text-sm font-medium text-gray-500">Total Value</dt>
          <dd class="text-sm text-gray-900 font-semibold text-lg">£<%= sprintf("%.2f", @customer_order.total_value) %></dd>
        </div>
      </dl>
    </div>
  </div>

  <!-- Works Orders -->
  <div class="bg-white shadow rounded-lg p-6">
    <div class="flex justify-between items-center mb-4">
      <h2 class="text-xl font-semibold text-gray-900">Works Orders</h2>
      <% unless @customer_order.voided %>
        <%= link_to "Add Works Order", new_customer_order_works_order_path(@customer_order),
            class: "bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded text-sm" %>
      <% end %>
    </div>

    <% if @works_orders.any? %>
      <div class="overflow-x-auto">
      <%# Batching: tick two or more open, ungrouped, unreleased WOs and batch
          them into one process group (one shared record, one sign-off per
          tank load). Route identity is enforced on submit - parts that don't
          run the identical process are refused with a message naming them. %>
      <%= form_with url: process_groups_path, method: :post, local: true do %>
        <% if @batchable_wo_ids.length >= 2 %>
          <div class="flex items-center justify-between mb-2">
            <p class="text-xs text-gray-500">
              Tick works orders that will run as one tank load, then batch them —
              they'll share a single process record and sign-off.
            </p>
            <button type="submit"
                    class="bg-indigo-500 hover:bg-indigo-700 text-white text-sm font-bold py-1.5 px-3 rounded">
              Batch together
            </button>
          </div>
        <% end %>
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <% if @batchable_wo_ids.length >= 2 %>
                <th class="px-3 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  Batch
                </th>
              <% end %>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                WO Number
              </th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Part Number
              </th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Quantity
              </th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Progress
              </th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Invoice Status
              </th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Status
              </th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Actions
              </th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% @works_orders.each do |works_order| %>
              <%
                wo_uninvoiced = works_order.release_notes.requires_invoicing.sum(:quantity_accepted)
                wo_invoiced = works_order.release_notes.joins(:invoice_item).sum(:quantity_accepted)

              %>
              <tr class="hover:bg-gray-50">
                <% if @batchable_wo_ids.length >= 2 %>
                  <td class="px-3 py-4 whitespace-nowrap">
                    <% if @batchable_wo_ids.include?(works_order.id) %>
                      <%= check_box_tag "wo_ids[]", works_order.id, false,
                          id: "batch_wo_#{works_order.id}",
                          class: "h-4 w-4 text-indigo-600 border-gray-300 rounded" %>
                    <% end %>
                  </td>
                <% end %>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                  <%= link_to "WO#{works_order.number}", works_order, class: "text-blue-600 hover:text-blue-900" %>
                  <% if works_order.grouped? %>
                    <span class="ml-1 inline-flex px-2 py-0.5 text-xs font-semibold rounded-full bg-indigo-100 text-indigo-800"
                          title="<%= works_order.process_lead? ? "Holds the shared process record for this tank load" : "Processed as one tank load; record on WO#{works_order.process_record_owner.number}" %>">
                      <%= works_order.process_group.display_name %><%= " ● record" if works_order.process_lead? %>
                    </span>
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                  <%= works_order.part_number %>-<%= works_order.part_issue %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                  <%= works_order.quantity %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                  <% if works_order.quantity_released > 0 %>
                    <span class="text-green-600 font-medium">
                      <%= works_order.quantity_released %> released
                    </span>
                    <% if works_order.quantity_remaining > 0 %>
                      <span class="text-gray-500">
                        (<%= works_order.quantity_remaining %> remaining)
                      </span>
                    <% end %>
                  <% else %>
                    <span class="text-gray-500">Not started</span>
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm">
                  <% if wo_uninvoiced > 0 %>
                    <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full bg-orange-100 text-orange-800">
                      <%= wo_uninvoiced %> ready
                    </span>
                  <% elsif wo_invoiced > 0 %>
                    <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full bg-green-100 text-green-800">
                      <%= wo_invoiced %> invoiced
                    </span>
                  <% else %>
                    <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full bg-gray-100 text-gray-800">
                      None yet
                    </span>
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <% if works_order.voided %>
                    <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full bg-red-100 text-red-800">
                      Voided
                    </span>
                  <% elsif works_order.is_open %>
                    <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full bg-green-100 text-green-800">
                      Open
                    </span>
                  <% else %>
                    <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full bg-gray-100 text-gray-800">
                      Closed
                    </span>
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                  <div class="flex space-x-2">
                    <%= link_to "View", works_order, class: "text-blue-600 hover:text-blue-900" %>
                    <% unless works_order.voided %>
                      <%= link_to "Edit", edit_works_order_path(works_order), class: "text-yellow-600 hover:text-yellow-900" %>
                      <% if works_order.grouped_member? %>
                        <%= link_to "📱 #{works_order.process_group.display_name} → WO#{works_order.process_record_owner.number}",
                            works_order_path(works_order.process_record_owner),
                            title: "Processed as one tank load - the shared process record is on WO#{works_order.process_record_owner.number}. No route card is printed for this works order.",
                            class: "text-indigo-600 hover:text-indigo-900" %>
                      <% elsif works_order.process_lead? %>
                        <%= link_to "📱 #{works_order.process_group.display_name} record",
                            works_order_path(works_order),
                            title: "Holds the shared process record for the whole tank load (#{works_order.process_group.total_quantity} parts) - kept in HAMS only, no route card",
                            class: "text-indigo-600 hover:text-indigo-900" %>
                      <% elsif @paperless_wo_ids.include?(works_order.id) %>
                        <span class="text-gray-400 cursor-help"
                              title="Process records are kept in HAMS only - no route card">
                          📱 Paperless
                        </span>
                      <% else %>
                        <%= link_to "Route Card", route_card_works_order_path(works_order),
                            class: "text-green-600 hover:text-green-900", target: "_blank" %>
                      <% end %>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% end %>
      </div>
    <% else %>
      <div class="text-center py-8">
        <p class="text-gray-500">No works orders yet.</p>
        <% unless @customer_order.voided %>
          <%= link_to "Create the first works order", new_customer_order_works_order_path(@customer_order),
              class: "text-blue-600 hover:text-blue-900 font-medium" %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<%# ==========================================================================
    Quick Bookout modal (native <dialog> — no JS framework wiring).
    Bookable rows: paperless records with in-line (or no) thickness; the
    quantity shown is what CustomerOrder#quick_bookout! will actually create
    (recomputed server-side on submit — the checkboxes are only a selection).
    Blocked rows are listed with the reason and a link to release manually.
    ========================================================================== %>
<% if @bookout_candidates.any? %>
  <% bookable = @bookout_candidates.select { |c| c.reason.nil? } %>
  <% blocked  = @bookout_candidates.reject { |c| c.reason.nil? } %>

  <dialog id="bookout-modal" class="rounded-lg shadow-xl p-0 w-full max-w-2xl">
    <style>#bookout-modal::backdrop { background: rgba(0,0,0,0.5); }</style>

    <div class="flex justify-between items-center px-6 py-4 border-b border-gray-200">
      <h2 class="text-xl font-semibold text-gray-900">Quick Bookout — <%= @customer_order.number %></h2>
      <button type="button" onclick="this.closest('dialog').close()"
              class="text-gray-400 hover:text-gray-600 text-2xl leading-none">&times;</button>
    </div>

    <div class="px-6 py-4">
      <% if bookable.any? %>
        <%= form_with url: bookout_customer_order_path(@customer_order), method: :post, local: true do %>
          <p class="text-sm text-gray-600 mb-3">
            Each ticked works order gets one release note for every part its process
            record certifies but hasn't yet released — all booked as accepted.
            Rejections and partial quantities go through the normal release form.
          </p>

          <table class="min-w-full divide-y divide-gray-200 mb-4">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-3 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Book</th>
                <th class="px-3 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Works Order</th>
                <th class="px-3 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Part</th>
                <th class="px-3 py-2 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Qty to book</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
              <% bookable.each do |c| %>
                <tr>
                  <td class="px-3 py-2">
                    <%= check_box_tag "works_order_ids[]", c.works_order.id, true,
                        id: "bookout_wo_#{c.works_order.id}",
                        class: "h-4 w-4 text-blue-600 border-gray-300 rounded" %>
                  </td>
                  <td class="px-3 py-2 text-sm font-medium text-gray-900">WO<%= c.works_order.number %></td>
                  <td class="px-3 py-2 text-sm text-gray-700"><%= c.works_order.part_number %></td>
                  <td class="px-3 py-2 text-sm text-right font-semibold text-green-700"><%= c.quantity %></td>
                </tr>
              <% end %>
            </tbody>
            <tfoot>
              <tr class="bg-gray-50">
                <td colspan="3" class="px-3 py-2 text-sm font-semibold text-right">Total</td>
                <td class="px-3 py-2 text-sm text-right font-bold"><%= bookable.sum(&:quantity) %></td>
              </tr>
            </tfoot>
          </table>

          <div class="flex justify-end space-x-2">
            <button type="button" onclick="this.closest('dialog').close()"
                    class="bg-gray-200 hover:bg-gray-300 text-gray-800 font-bold py-2 px-4 rounded">
              Cancel
            </button>
            <button type="submit"
                    class="bg-blue-600 hover:bg-blue-800 text-white font-bold py-2 px-4 rounded"
                    data-disable-with="Booking out…">
              Book out selected
            </button>
          </div>
        <% end %>
      <% else %>
        <p class="text-sm text-gray-600 mb-3">
          Nothing is auto-bookable right now — see below for why.
        </p>
      <% end %>

      <% if blocked.any? %>
        <div class="mt-4 border-t border-gray-200 pt-3">
          <h3 class="text-sm font-semibold text-gray-700 mb-2">Not auto-bookable</h3>
          <ul class="space-y-1 text-sm text-gray-600">
            <% blocked.each do |c| %>
              <li class="flex justify-between items-center">
                <span>
                  <span class="font-medium text-gray-900">WO<%= c.works_order.number %></span>
                  · <%= c.works_order.part_number %> ·
                  <% if c.reason == :awaiting_sign_off %>
                    nothing new signed off on the process record
                  <% elsif c.reason == :manual_thickness %>
                    thickness readings are captured on the release form
                  <% elsif c.reason == :paper_record %>
                    paper route card — sign-offs aren't in HAMS
                  <% end %>
                </span>
                <% if c.reason == :awaiting_sign_off %>
                  <%= link_to "Open WO", works_order_path(c.works_order),
                      class: "text-blue-600 hover:text-blue-900 ml-3 whitespace-nowrap" %>
                <% else %>
                  <%= link_to "Release manually", new_works_order_release_note_path(c.works_order),
                      class: "text-blue-600 hover:text-blue-900 ml-3 whitespace-nowrap" %>
                <% end %>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>
    </div>
  </dialog>
<% end %>
