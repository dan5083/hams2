<% content_for :head do %>
  <%# Signing off redirects back to this exact URL. Turbo treats a redirect to
      the page you are already on as a refresh, so with these two it morphs the
      DOM in place and keeps the scroll position: the operator watches the row
      they just signed turn green instead of being thrown back up the card. %>
  <meta name="turbo-refresh-method" content="morph">
  <meta name="turbo-refresh-scroll" content="preserve">
<% end %>

<div class="container mx-auto px-4 py-6">
  <%
    # Hoisted above the header: the timers banner and the NADCAP accent both
    # need these before the grid renders.
    operations = (@works_order.operations_for_display rescue [])
    aero = @works_order.aerospace_defense?
    # OCV *monitoring* specifically - nadcap-basis specs. Correct on frozen
    # records regardless of the part's current flag.
    has_ocv = operations.any? { |op| op["ocv"].is_a?(Hash) && op["ocv"]["basis"].to_s == "nadcap" }
  %>

  <div class="flex justify-between items-center mb-6">
    <div class="flex items-center gap-3 flex-wrap">
      <h1 class="text-3xl font-bold text-gray-900">Works Order WO<%= @works_order.number %></h1>
      <% if aero %>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider text-white bg-gradient-to-r from-amber-500 via-orange-500 to-red-500 shadow-md"
              title="Aerospace/defence part — processed under NADCAP accreditation">
          ✈ NADCAP · Aerospace/Defence
        </span>
      <% end %>
    </div>
    <div class="flex space-x-2">
      <%= link_to "Edit", edit_works_order_path(@works_order),
          class: "bg-yellow-500 hover:bg-yellow-700 text-white font-bold py-2 px-4 rounded" %>

      <% if @works_order.paperless_record? %>
        <span class="bg-gray-100 text-gray-500 font-medium py-2 px-4 rounded"
              title="ENP process records are kept in HAMS only - no route card">
          📱 Paperless
        </span>
      <% elsif @works_order.grouped_member? %>
        <%# The record lives on the group's lead WO - never print a paper
            card for a member, the digital record covers it. %>
        <%= link_to "📱 Process Record → WO#{@works_order.process_record_owner.number}",
            works_order_path(@works_order.process_record_owner),
            class: "bg-indigo-500 hover:bg-indigo-700 text-white font-bold py-2 px-4 rounded" %>
      <% else %>
        <%= link_to "Route Card",
            "javascript:void(0)",
            onclick: "printRouteCard('#{route_card_works_order_path(@works_order)}')",
            class: "bg-green-500 hover:bg-green-700 text-white font-bold py-2 px-4 rounded" %>
      <% end %>

      <%= link_to "New Release Note", new_works_order_release_note_path(@works_order),
          class: "bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded" %>

      <%= link_to "Back to Works Orders", works_orders_path,
          class: "bg-gray-500 hover:bg-gray-700 text-white font-bold py-2 px-4 rounded" %>
    </div>
  </div>

  <% if aero && has_ocv %>
    <div class="mb-4 flex items-center gap-2.5 rounded-lg border-2 border-red-300 bg-red-50 px-4 py-2.5">
      <span class="text-lg">⏱</span>
      <p class="text-sm font-bold text-red-800 uppercase tracking-wide">
        When OCV monitoring use calibrated timers ONLY
      </p>
    </div>
  <% end %>

  <% if @works_order.grouped? %>
    <div class="mb-4 rounded-lg border border-indigo-200 bg-indigo-50 px-4 py-3">
      <% group = @works_order.process_group %>
      <% if @works_order.process_lead? %>
        <div class="text-sm font-semibold text-indigo-900">
          <%= group.display_name %> — this process record covers the whole tank load
          (<%= group.total_quantity %> parts across <%= group.members.count %> works orders)
        </div>
        <div class="mt-1 text-sm text-indigo-800">
          <% group.members.each do |m| %>
            <span class="inline-block mr-3">
              <% if m.id == @works_order.id %>
                <span class="font-semibold"><%= m.display_name %></span>
              <% else %>
                <%= link_to m.display_name, works_order_path(m), class: "underline" %>
              <% end %>
              <span class="text-indigo-600"><%= m.part_number %> ×<%= m.quantity %></span>
            </span>
          <% end %>
        </div>
      <% else %>
        <div class="text-sm text-indigo-900">
          <span class="font-semibold"><%= group.display_name %>:</span>
          this works order is processed as one tank load with
          <%= group.members.count - 1 %> other<%= 's' unless group.members.count == 2 %> —
          the shared process record is on
          <%= link_to "WO#{@works_order.process_record_owner.number}",
              works_order_path(@works_order.process_record_owner),
              class: "font-semibold underline" %>.
          Release notes, certificates and invoicing stay on this WO as normal.
        </div>
      <% end %>
    </div>
  <% end %>

  <% if @works_order.customer_reference.present? %>
    <div class="mb-4">
      <dt class="text-sm font-medium text-gray-500">Customer Reference</dt>
      <dd class="text-sm text-gray-900"><%= @works_order.customer_reference %></dd>
    </div>
  <% end %>

  <!-- Main layout: narrow left (details) + wide right (operations preview) -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">

    <!-- LEFT COLUMN: stacked detail panels -->
    <div class="lg:col-span-1 space-y-6">

      <!-- Basic Details -->
      <div class="bg-white shadow rounded-lg p-6">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Basic Details</h2>
        <dl class="space-y-3">
          <div>
            <dt class="text-sm font-medium text-gray-500">Customer</dt>
            <dd class="text-sm text-gray-900"><%= @works_order.customer.name %></dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">Customer Order</dt>
            <dd class="text-sm text-gray-900">
              <%= link_to @works_order.customer_order.number, @works_order.customer_order,
                  class: "text-blue-600 hover:text-blue-900" %>
            </dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">Part Number</dt>
            <dd class="text-sm text-gray-900">
              <%= link_to "#{@works_order.part_number}-#{@works_order.part_issue}", @works_order.part,
                  class: "text-blue-600 hover:text-blue-900" %>
            </dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">Processing History</dt>
            <dd class="text-sm text-gray-900">
              <% wo_count = @works_order.part&.works_orders&.active&.count.to_i %>
              <% if wo_count <= 1 %>
                <span class="px-1.5 py-0.5 rounded bg-yellow-100 text-yellow-800 font-semibold">NEW PART</span>
              <% else %>
                <% prev_wos = @works_order.part.works_orders.active.where.not(id: @works_order.id)
                                          .order(created_at: :desc).limit(5) %>
                Processed <%= wo_count %> times
                <ul class="mt-1 space-y-0.5">
                  <% prev_wos.each do |prev| %>
                    <li class="text-xs text-gray-500">
                      <%= link_to "WO#{prev.number}", works_order_path(prev), class: "text-blue-600 hover:text-blue-900" %>
                      · <%= prev.created_at.strftime("%d/%m/%y") %>
                      · qty <%= prev.quantity %><%= " (#{prev.quantity_released} released)" if prev.quantity_released != prev.quantity %>
                      <% if prev.is_open %><span class="text-green-600">· open</span><% end %>
                    </li>
                  <% end %>
                  <% if wo_count - 1 > prev_wos.length %>
                    <li class="text-xs text-gray-400">… and <%= wo_count - 1 - prev_wos.length %> more</li>
                  <% end %>
                </ul>
              <% end %>
            </dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">Description</dt>
            <dd class="text-sm text-gray-900"><%= @works_order.part_description %></dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">Specification</dt>
            <dd class="text-sm text-gray-900"><%= @works_order.specification.presence || "—" %></dd>
          </div>
          <% if @works_order.material.present? %>
            <div>
              <dt class="text-sm font-medium text-gray-500">Material</dt>
              <dd class="text-sm text-gray-900"><%= @works_order.material %></dd>
            </div>
          <% end %>
          <% if @works_order.specified_thicknesses.present? %>
            <div>
              <dt class="text-sm font-medium text-gray-500">Specified Thickness(es)</dt>
              <dd class="text-sm text-gray-900"><%= @works_order.specified_thicknesses %></dd>
            </div>
          <% end %>
        </dl>
      </div>

      <!-- Quantity & Pricing -->
      <div class="bg-white shadow rounded-lg p-6">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Quantity & Pricing</h2>
        <dl class="space-y-3">
          <div>
            <dt class="text-sm font-medium text-gray-500">Quantity Ordered</dt>
            <dd class="text-sm text-gray-900"><%= @works_order.quantity %></dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">Quantity Released</dt>
            <dd class="text-sm text-gray-900"><%= @works_order.quantity_released %></dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">Quantity Remaining</dt>
            <dd class="text-sm font-semibold <%= @works_order.quantity_remaining > 0 ? 'text-green-600' : 'text-red-600' %>">
              <%= @works_order.quantity_remaining %>
            </dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">Price Type</dt>
            <dd class="text-sm text-gray-900"><%= @works_order.price_type.capitalize %></dd>
          </div>
          <% if @works_order.each_price.present? %>
            <div>
              <dt class="text-sm font-medium text-gray-500">Each Price</dt>
              <dd class="text-sm text-gray-900">£<%= sprintf("%.2f", @works_order.each_price) %></dd>
            </div>
          <% end %>
          <div>
            <dt class="text-sm font-medium text-gray-500">Lot Price</dt>
            <dd class="text-sm text-gray-900">£<%= sprintf("%.2f", @works_order.lot_price) %></dd>
          </div>
        </dl>
      </div>

      <!-- Additional Charges -->
      <% if @works_order.selected_charge_ids.present? && @works_order.selected_charge_ids.any? %>
        <div class="bg-white shadow rounded-lg p-6">
          <h2 class="text-lg font-semibold text-gray-900 mb-4">Additional Charges</h2>
          <dl class="space-y-3">
            <%
              selected_charges = @works_order.get_selected_additional_charges
              total_additional_charges = 0.0
            %>
            <% selected_charges.each do |charge| %>
              <div class="flex justify-between items-start">
                <dt class="text-sm font-medium text-gray-500">
                  <%= charge.name %>
                  <% if charge.is_variable? %>
                    <% custom_amount = @works_order.get_custom_amount(charge.id)&.to_f %>
                    <% if custom_amount.present? && custom_amount > 0 %>
                      <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full bg-blue-100 text-blue-800 ml-1">Custom</span>
                    <% else %>
                      <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full bg-yellow-100 text-yellow-800 ml-1">Variable</span>
                    <% end %>
                  <% end %>
                </dt>
                <dd class="text-sm text-gray-900 font-medium">
                  <%
                    if charge.is_variable?
                      custom_amount = @works_order.get_custom_amount(charge.id).to_f
                      display_amount = custom_amount > 0 ? custom_amount : (charge.amount || 0).to_f
                      total_additional_charges += display_amount
                  %>
                    £<%= sprintf("%.2f", display_amount) %>
                  <% else
                      total_additional_charges += (charge.amount || 0).to_f
                  %>
                    £<%= sprintf("%.2f", charge.amount || 0) %>
                  <% end %>
                </dd>
              </div>
            <% end %>
            <div class="flex justify-between items-start pt-3 border-t border-gray-200">
              <dt class="text-sm font-semibold text-gray-700">Total Additional Charges</dt>
              <dd class="text-sm font-bold text-gray-900">£<%= sprintf("%.2f", total_additional_charges) %></dd>
            </div>
            <div class="flex justify-between items-start pt-2 border-t-2 border-gray-300">
              <dt class="text-base font-bold text-gray-900">Grand Total</dt>
              <dd class="text-base font-bold text-blue-600">£<%= sprintf("%.2f", @works_order.lot_price + total_additional_charges) %></dd>
            </div>
          </dl>
        </div>
      <% end %>

      <!-- Status & Dates -->
      <div class="bg-white shadow rounded-lg p-6">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Status & Dates</h2>
        <dl class="space-y-3">
          <div>
            <dt class="text-sm font-medium text-gray-500">Created</dt>
            <dd class="text-sm text-gray-900"><%= @works_order.created_at.strftime("%d/%m/%Y %H:%M") %></dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">Status</dt>
            <dd class="text-sm">
              <% if @works_order.is_open %>
                <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full bg-green-100 text-green-800">Open</span>
              <% else %>
                <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full bg-gray-100 text-gray-800">Closed</span>
              <% end %>
            </dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">Manufacturing Status</dt>
            <dd class="text-sm">
              <% if @works_order.manufacturing_complete? %>
                <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full bg-blue-100 text-blue-800">Complete</span>
              <% elsif @works_order.quantity_released > 0 %>
                <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full bg-yellow-100 text-yellow-800">In Progress</span>
              <% else %>
                <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full bg-gray-100 text-gray-800">Pending</span>
              <% end %>
            </dd>
          </div>
        </dl>
      </div>

    </div>

    <!-- RIGHT COLUMN: operations preview -->
    <div class="lg:col-span-2">
      <div class="bg-white shadow rounded-lg p-6 h-full <%= 'ring-2 ring-amber-400/70' if aero %>" id="process-operations-card">
        <div class="flex justify-between items-center mb-4">
          <div class="flex items-center gap-2">
            <h2 class="text-lg font-semibold text-gray-900">Process Operations</h2>
            <% if aero %>
              <span class="inline-flex px-2 py-0.5 text-xs font-bold rounded bg-amber-100 text-amber-800 border border-amber-300 uppercase tracking-wide"
                    title="OCV monitoring and sign-offs on this record form part of the NADCAP audit trail">NADCAP</span>
            <% end %>
          </div>
          <% if operations.any? %>
            <span class="text-sm text-gray-500"><%= operations.length %> operation<%= operations.length == 1 ? '' : 's' %></span>
          <% end %>
        </div>

        <% if @works_order.special_instructions.present? %>
          <div class="mb-4 p-3 bg-yellow-50 border border-yellow-200 rounded-lg">
            <p class="text-xs font-semibold text-yellow-800 uppercase tracking-wide mb-1">Special Instructions</p>
            <p class="text-sm text-yellow-900"><%= simple_format(@works_order.special_instructions) %></p>
          </div>
        <% end %>

        <% if @works_order.discards.any? %>
          <p class="mb-3 text-xs text-gray-400">
            Record restarted <%= @works_order.discards.length %> time<%= 's' unless @works_order.discards.length == 1 %>
            (last <%= Time.parse(@works_order.discards.last["at"]).strftime("%d/%m %H:%M") rescue @works_order.discards.last["at"] %>
            by <%= @works_order.discards.last["by"] %>)
          </p>
        <% end %>

        <% ops_for_display = operations %>
        <% paperless = @works_order.paperless_record? %>
        <% can_undo = paperless && @works_order.can_undo_sign_offs? %>
        <% batch_count = @works_order.process_batch_count %>
        <% active_batch = (@active_batch || 1).to_i %>
        <% wo_sections = @works_order.sections %>
        <% fork_by_from = wo_sections.drop(1).index_by { |s| s["from"] } %>
        <% active_fb = (@active_fork_batches || {}) %>
        <% if paperless && ops_for_display.any? %>
          <% statuses = @works_order.batch_statuses %>
          <% qty_total = @works_order.batched_quantity_total %>
          <% active_entry = @works_order.process_batches.find { |b| b["number"] == active_batch } || {} %>
          <% signed_batches = @works_order.signed_batch_numbers %>

          <div class="mb-4 p-3 bg-gray-50 border border-gray-200 rounded-lg space-y-3">

            <!-- Batching: parts per batch derives the count and the remainder -->
            <div class="flex flex-wrap items-center gap-3">
              <%= form_with url: set_parts_per_batch_works_order_path(@works_order), method: :patch, local: true, data: { turbo: false }, class: "flex flex-wrap items-center gap-2" do %>
                <label class="text-xs font-semibold text-gray-600 uppercase tracking-wide">Parts per batch</label>
                <%# Unset batching prefills the full order quantity - the
                    commonest case is everything through in one load, so the
                    initial state is "1 × N", one Apply away. %>
                <%= number_field_tag :parts_per_batch, @works_order.parts_per_batch || @works_order.record_quantity, min: 1, max: @works_order.record_quantity,
                    id: "parts-per-batch",
                    data: { quantity: @works_order.record_quantity, max_batches: WorksOrder::MAX_BATCHES, keyflow: "ppb" },
                    class: "border border-gray-300 rounded px-2 py-1 text-sm w-20" %>
                <%= submit_tag "Set batches", class: "bg-gray-600 hover:bg-gray-700 text-white text-xs font-medium px-2 py-1.5 rounded" %>
                <span id="batch-preview" class="text-xs text-gray-500"></span>
              <% end %>

              <span class="text-xs <%= qty_total == @works_order.record_quantity ? 'text-gray-400' : 'text-orange-600 font-medium' %>">
                <% if qty_total == @works_order.record_quantity %>
                  <%= batch_count %> batch<%= 'es' unless batch_count == 1 %> · <%= qty_total %> parts
                <% else %>
                  ⚠️ Batch quantities total <%= qty_total %>, <%= @works_order.process_lead? ? "tank load" : "order" %> is <%= @works_order.record_quantity %>
                <% end %>
              </span>
            </div>

            <!-- Active batch: the page renders one batch at a time -->
            <div class="flex flex-wrap items-center gap-3 pt-2 border-t border-gray-200">
              <label class="text-xs font-semibold text-gray-600 uppercase tracking-wide">Batch</label>
              <%= form_with url: works_order_path(@works_order), method: :get, local: true, data: { turbo: false }, class: "flex items-center gap-2" do %>
                <% active_fb.each do |k, v| %><%= hidden_field_tag "fb[#{k}]", v %><% end %>
                <%= select_tag :batch,
                    options_for_select(
                      (1..batch_count).map { |n|
                        entry = @works_order.process_batches.find { |b| b["number"] == n } || {}
                        mark = { complete: "✓", in_progress: "▸" }[statuses[n]] || "·"
                        date = entry["date"] ? " #{Date.parse(entry['date']).strftime('%d/%m')}" : ""
                        ["#{mark} B#{n}#{date} (qty #{entry['qty'].presence || '—'})", n]
                      }, active_batch),
                    onchange: "this.form.requestSubmit()",
                    class: "border border-gray-300 rounded px-2 py-1 text-sm" %>
              <% end %>

              <% if signed_batches.include?(active_batch) %>
                <span class="text-xs text-gray-400">Qty <%= active_entry["qty"] %> · locked by sign-off</span>
              <% else %>
                <%= form_with url: set_batch_qty_works_order_path(@works_order), method: :patch, local: true, data: { turbo: false }, class: "flex items-center gap-1" do %>
                  <%= hidden_field_tag :batch, active_batch %>
                  <% active_fb.each do |k, v| %><%= hidden_field_tag "fb[#{k}]", v %><% end %>
                  <span class="text-xs text-gray-500">Qty</span>
                  <%= number_field_tag :qty, active_entry["qty"], min: 1,
                      class: "border border-gray-300 rounded px-1 py-1 text-sm w-16" %>
                  <%= submit_tag "Set", class: "bg-gray-600 hover:bg-gray-700 text-white text-xs font-medium px-2 py-1 rounded" %>
                <% end %>
              <% end %>

              <div class="ml-auto flex items-center gap-1">
                <% if active_batch > 1 %>
                  <%= link_to "‹ B#{active_batch - 1}", works_order_path(@works_order, batch: active_batch - 1, fb: active_fb.presence),
                      class: "text-xs text-blue-600 hover:text-blue-900 px-2 py-1" %>
                <% end %>
                <% if active_batch < batch_count %>
                  <%= link_to "B#{active_batch + 1} ›", works_order_path(@works_order, batch: active_batch + 1, fb: active_fb.presence),
                      class: "text-xs text-blue-600 hover:text-blue-900 px-2 py-1" %>
                <% end %>
              </div>
            </div>

            <!-- Whole-WO progress: every sign-off the record requires - across
                 all fork sections AND the WO-scoped header ops - measured in
                 sign-off units (a batch-scoped op contributes one per batch in
                 ITS section, a WO-scoped op contributes one). The bar is full
                 exactly when the record is completely signed, which is what
                 release validation will require. -->
            <%
              total_units  = ops_for_display.sum { |o| @works_order.sign_off_keys_for(o).length }
              signed_units = ops_for_display.sum { |o| @works_order.signed_count_for(o) }
              # Recorded-but-unsigned units: readings entered, sign-off pending
              partial_units = ops_for_display.sum do |o|
                keys = @works_order.sign_off_keys_for(o)
                (o["ocv_readings"] || {}).count do |k, v|
                  keys.include?(k) && v.present? && (o["sign_offs"] || {})[k].blank?
                end
              end
              remaining_units = total_units - signed_units - partial_units
            %>
            <div>
              <div class="flex gap-px h-2 rounded overflow-hidden">
                <% if signed_units > 0 %><div class="bg-green-500" style="flex: <%= signed_units %>"></div><% end %>
                <% if partial_units > 0 %><div class="bg-amber-500" style="flex: <%= partial_units %>"></div><% end %>
                <% if remaining_units > 0 %><div class="bg-gray-300" style="flex: <%= remaining_units %>"></div><% end %>
              </div>
              <p class="mt-1 text-xs text-gray-500">
                <%= signed_units %>/<%= total_units %> sign-offs<% if partial_units > 0 %> · <%= partial_units %> recorded, awaiting sign-off<% end %>
              </p>
            </div>

            <!-- Manual escape hatch: physical reality diverges from arithmetic -->
            <details class="text-xs">
              <summary class="cursor-pointer select-none text-gray-500 hover:text-gray-700">Set batch count manually</summary>
              <%= form_with url: set_batch_count_works_order_path(@works_order), method: :patch, local: true, data: { turbo: false }, class: "flex items-center gap-2 mt-2" do %>
                <span class="text-gray-500">Batches</span>
                <%= number_field_tag :batch_count, batch_count, min: 1, max: WorksOrder::MAX_BATCHES,
                    class: "border border-gray-300 rounded px-2 py-1 text-sm w-20" %>
                <%= submit_tag "Update", class: "bg-gray-600 hover:bg-gray-700 text-white text-xs font-medium px-2 py-1 rounded" %>
                <span class="text-gray-400">Quantities are then set per batch above.</span>
              <% end %>
            </details>

            <!-- 🌵 Fork: from a given operation onward the parts regroup into a
                 new batch structure. Renders as a divider in the ops list.
                 Collapsed by default - only needed on the harder parts. -->
            <details class="text-xs pt-2 border-t border-gray-200">
              <summary class="cursor-pointer select-none text-gray-500 hover:text-gray-700">🌵 Fork batches part-way down the process</summary>
              <%
                # Eligible fork points: batch-scoped ops after the first one,
                # skipping any op that already starts a fork.
                batchable = ops_for_display.reject { |o| @works_order.wo_scoped_operation?(o) }
                first_batchable = batchable.first&.dig("position").to_i
                existing_forks = @works_order.forks.map { |f| f["from_position"].to_i }
                fork_choices = batchable.select { |o| o["position"].to_i > first_batchable }
                                        .reject { |o| existing_forks.include?(o["position"].to_i) }
                                        .map { |o| ["#{o['position']} — #{o['operation_text'].to_s.gsub(/\*+/, '').truncate(48)}", o["position"]] }
              %>
              <%= form_with url: add_fork_works_order_path(@works_order), method: :patch, local: true, data: { turbo: false }, class: "flex flex-wrap items-center gap-2 mt-2" do %>
                <span class="text-gray-500">From op</span>
                <%= select_tag :from_position, options_for_select([["choose…", ""]] + fork_choices),
                    class: "border border-gray-300 rounded px-2 py-1 text-sm max-w-96" %>
                <span class="text-gray-500">at</span>
                <%= number_field_tag :parts_per_batch, nil, min: 1, max: @works_order.record_quantity, placeholder: "per batch",
                    class: "border border-gray-300 rounded px-2 py-1 text-sm w-24" %>
                <span class="text-gray-500">per batch</span>
                <%= hidden_field_tag :base_batch, active_batch %>
                <% active_fb.each do |k, v| %><%= hidden_field_tag "fb[#{k}]", v %><% end %>
                <%= submit_tag "Add fork", class: "bg-gray-600 hover:bg-gray-700 text-white text-xs font-medium px-2 py-1.5 rounded" %>
                <span class="text-gray-400">parts regroup from that op onward</span>
              <% end %>
            </details>
          </div>

          <% if @works_order.can_discard_process_record? %>
            <details class="mb-4 text-xs">
              <summary class="cursor-pointer select-none text-red-600 hover:text-red-800">
                Discard this process record and start again
              </summary>
              <div class="mt-2 p-3 bg-red-50 border border-red-200 rounded-lg">
                <p class="text-xs text-red-900 mb-2">
                  Clears every sign-off, OCV reading and batch date on this works order and goes back to
                  rendering operations live from the part — the equivalent of binning a route card and
                  reprinting it. Batch numbers and quantities are kept. Only available because nothing
                  has been released against this works order.
                </p>
                <%= form_with url: discard_process_record_works_order_path(@works_order), method: :patch, local: true, data: { turbo: false }, class: "flex flex-wrap items-center gap-2" do %>
                  <%= submit_tag "Discard record",
                      data: { confirm: "Discard all sign-offs and readings on WO#{@works_order.number}? The discarded record is kept, but the operators will have to sign off again." },
                      class: "bg-red-600 hover:bg-red-700 text-white text-xs font-medium px-3 py-1.5 rounded" %>
                <% end %>
              </div>
            </details>
          <% end %>
        <% end %>
        <% if ops_for_display.any? %>
          <%# Keyboard-flow hint. Rendered hidden here; the keyflow JS moves it
              into the first focused op card and reveals it (so it only ever
              shows on desktop, where the keyflow runs). Session-scoped: the JS
              keeps it away once a sign-off has happened in this browser
              session, so it coaches the first sign-off of the session and
              then stays gone - whatever state the record itself is in. %>
          <% if paperless %>
            <div id="keyflow-hint" class="hidden px-4 py-2.5 bg-blue-50 border-b border-blue-200 text-xs text-blue-900 leading-relaxed">
              ⌨ Press <kbd class="px-1 py-0.5 bg-white border border-blue-300 rounded font-semibold">Enter</kbd>
              to sign this op off and jump to the next one. Press any other key to skip it
              (<kbd class="px-1 py-0.5 bg-white border border-blue-300 rounded font-semibold">↑</kbd> goes back).
              Stick to the keyboard &mdash; using the mouse part-way through can lose your place.
            </div>
          <% end %>
          <%# elcometer-session: one shared Elcometer connection for the page; the
              thickness cards (film_thickness_field) register as sinks. %>
          <div class="space-y-3" data-controller="elcometer-session">
            <% current_sec = wo_sections.first %>
            <% @elcometer_toolbar_rendered = false %>
            <% ops_for_display.each do |op| %>
              <% position = op["position"] %>

              <% if paperless && (fork_sec = fork_by_from[position.to_i]) %>
                <% current_sec = fork_sec %>
                <% f_key = fork_sec["key"] %>
                <% f_count = @works_order.section_batch_count(fork_sec) %>
                <% f_active = (active_fb[f_key] || 1).to_i %>
                <% f_statuses = @works_order.section_batch_statuses(fork_sec) %>
                <% f_complete = f_statuses.count { |_n, s| s == :complete } %>
                <% f_in_progress = f_statuses.count { |_n, s| s == :in_progress } %>
                <% f_qty_total = @works_order.section_batched_quantity_total(fork_sec) %>
                <% f_entry = @works_order.section_batches(fork_sec).find { |b| b["number"] == f_active } || {} %>
                <% f_signed = @works_order.section_signed_batch_numbers(fork_sec) %>
                <% f_removable = @works_order.section_highest_recorded_batch(fork_sec).zero? %>
                <!-- 🌵 Fork divider: the paper card's ruled line and "rebatched into N loads".
                     Everything below runs in this section's batch structure. -->
                <div class="p-3 bg-gray-100 border-2 border-gray-300 rounded-lg space-y-2" id="fork-<%= f_key %>">
                  <div class="flex flex-wrap items-center gap-3">
                    <span class="text-xs font-bold text-gray-700 uppercase tracking-wide">
                      🌵 Rebatch from op <%= fork_sec["from"] %>: <%= f_count %> × <%= @works_order.section_parts_per_batch(fork_sec) %>
                    </span>
                    <span class="text-xs <%= f_qty_total == @works_order.record_quantity ? 'text-gray-400' : 'text-orange-600 font-medium' %>">
                      <% if f_qty_total == @works_order.record_quantity %>
                        <%= f_qty_total %> parts
                      <% else %>
                        ⚠️ quantities total <%= f_qty_total %>, <%= @works_order.process_lead? ? "tank load" : "order" %> is <%= @works_order.record_quantity %>
                      <% end %>
                    </span>
                    <span class="text-xs text-gray-500"><%= f_complete %>/<%= f_count %> complete<%= " · #{f_in_progress} in progress" if f_in_progress > 0 %></span>
                    <% if f_removable %>
                      <%= button_to "✕ remove", remove_fork_works_order_path(@works_order, from_position: fork_sec["from"], base_batch: active_batch),
                          method: :patch, form: { data: { turbo: false }, class: "ml-auto" },
                          data: { confirm: "Remove the fork at op #{fork_sec['from']}? Its operations go back to the works order's own batching." },
                          class: "text-xs text-red-500 hover:text-red-700" %>
                    <% end %>
                  </div>
                  <div class="flex flex-wrap items-center gap-3">
                    <label class="text-xs font-semibold text-gray-600 uppercase tracking-wide">Batch</label>
                    <%= form_with url: works_order_path(@works_order), method: :get, local: true, data: { turbo: false }, class: "flex items-center gap-2" do %>
                      <%= hidden_field_tag :batch, active_batch %>
                      <% active_fb.reject { |k, _v| k == f_key }.each do |k, v| %><%= hidden_field_tag "fb[#{k}]", v %><% end %>
                      <%= select_tag "fb[#{f_key}]",
                          options_for_select(
                            (1..f_count).map { |n|
                              entry = @works_order.section_batches(fork_sec).find { |b| b["number"] == n } || {}
                              mark = { complete: "✓", in_progress: "▸" }[f_statuses[n]] || "·"
                              date = entry["date"] ? " #{Date.parse(entry['date']).strftime('%d/%m')}" : ""
                              ["#{mark} B#{n}#{date} (qty #{entry['qty'].presence || '—'})", n]
                            }, f_active),
                          onchange: "this.form.requestSubmit()",
                          class: "border border-gray-300 rounded px-2 py-1 text-sm" %>
                    <% end %>
                    <% if f_signed.include?(f_active) %>
                      <span class="text-xs text-gray-400">Qty <%= f_entry["qty"] %> · locked by sign-off</span>
                    <% else %>
                      <%= form_with url: set_batch_qty_works_order_path(@works_order), method: :patch, local: true, data: { turbo: false }, class: "flex items-center gap-1" do %>
                        <%= hidden_field_tag :section, f_key %>
                        <%= hidden_field_tag :batch, f_active %>
                        <%= hidden_field_tag :base_batch, active_batch %>
                        <% active_fb.each do |k, v| %><%= hidden_field_tag "fb[#{k}]", v %><% end %>
                        <span class="text-xs text-gray-500">Qty</span>
                        <%= number_field_tag :qty, f_entry["qty"], min: 1,
                            class: "border border-gray-300 rounded px-1 py-1 text-sm w-16" %>
                        <%= submit_tag "Set", class: "bg-gray-600 hover:bg-gray-700 text-white text-xs font-medium px-2 py-1 rounded" %>
                      <% end %>
                    <% end %>
                    <div class="ml-auto flex items-center gap-1">
                      <% if f_active > 1 %>
                        <%= link_to "‹ B#{f_active - 1}", works_order_path(@works_order, batch: active_batch, fb: active_fb.merge(f_key => f_active - 1)),
                            class: "text-xs text-blue-600 hover:text-blue-900 px-2 py-1" %>
                      <% end %>
                      <% if f_active < f_count %>
                        <%= link_to "B#{f_active + 1} ›", works_order_path(@works_order, batch: active_batch, fb: active_fb.merge(f_key => f_active + 1)),
                            class: "text-xs text-blue-600 hover:text-blue-900 px-2 py-1" %>
                      <% end %>
                    </div>
                  </div>
                </div>
              <% elsif fork_by_from[position.to_i] %>
                <% current_sec = fork_by_from[position.to_i] %>
              <% end %>

              <% sec_key = current_sec["key"] %>
              <% sec_active = (sec_key == "base" ? active_batch : (active_fb[sec_key] || 1)).to_i %>
              <% sec_batch_count = @works_order.section_batch_count(current_sec) %>
              <% spec = op["ocv"] %>
              <% op_keys = @works_order.sign_off_keys_for(op) %>
              <% wo_scoped = (op_keys == ["wo"]) %>
              <% active_key = wo_scoped ? "wo" : sec_active.to_s %>
              <% signed_here = (op["sign_offs"] || {})[active_key].present? %>
              <% signed_count = @works_order.signed_count_for(op) %>
              <% op_signed = signed_count == op_keys.length %>
              <%# Checklist-bearing ops (contract review) review the route BELOW
                  them - keep the rest of the card readable while focused there.
                  Final inspection stays spotlit: its stamp-check is moving to
                  release validation, so the operator doesn't scan for it. %>
              <div class="border border-gray-200 rounded-lg overflow-hidden" id="op-<%= position %>"
                   <%= "data-keep-context".html_safe if spec.is_a?(Hash) && spec["checklist"].present? %>>
                <div class="flex items-stretch">
                  <!-- Op number: state shown is for the ACTIVE batch -->
                  <div class="flex-none w-12 <%= signed_here ? 'bg-green-100 border-green-200' : (signed_count > 0 ? 'bg-amber-50 border-amber-200' : 'bg-gray-100 border-gray-200') %> border-r flex items-center justify-center">
                    <span class="text-sm font-bold <%= signed_here ? 'text-green-700' : (signed_count > 0 ? 'text-amber-700' : 'text-gray-700') %>"><%= position %></span>
                  </div>
                  <!-- Op content -->
                  <div class="flex-1 px-4 py-3 text-sm text-gray-900 leading-relaxed">
                    <%= simple_format(op["operation_text"].to_s) %>

                    <%# Operation notes: the digital margin annotation. Rare, so the
                        add form hides in a collapsed details; existing notes always
                        show. Append-only - the model guard stops edits/removal, so
                        a wrong note is superseded by another note, never erased. %>
                    <% op_notes = op["notes"] || [] %>
                    <% if op_notes.any? %>
                      <div class="mt-2 space-y-1">
                        <% op_notes.each do |n| %>
                          <div class="px-2.5 py-1.5 bg-amber-50 border-l-2 border-amber-400 rounded-r text-xs text-amber-900">
                            📝 <%= n["text"] %>
                            <span class="block mt-0.5 text-amber-600">
                              — <%= n.dig("by", "name") %>,
                              <%= (Time.parse(n["at"]).strftime("%d/%m/%y %H:%M") rescue n["at"]) %>
                            </span>
                          </div>
                        <% end %>
                      </div>
                    <% end %>
                    <% op_undos = (op["sign_off_undos"] || []).select { |u| u["batch"] == active_key } %>
                    <% op_undos.each do |u| %>
                      <p class="mt-1.5 text-xs text-gray-400">
                        ↩ Sign-off by <%= u.dig("was", "name") %> undone by <%= u.dig("by", "name") %>,
                        <%= (Time.parse(u["at"]).strftime("%d/%m/%y %H:%M") rescue u["at"]) %>
                      </p>
                    <% end %>
                    <% if paperless %>
                      <details class="mt-2 text-xs">
                        <summary class="cursor-pointer select-none text-gray-400 hover:text-gray-600">📝 Add note</summary>
                        <%= form_with url: add_operation_note_works_order_path(@works_order), method: :patch, local: true, class: "mt-1.5 flex items-start gap-2" do %>
                          <%= hidden_field_tag :position, position %>
                          <%= hidden_field_tag :batch, active_batch %>
                          <% active_fb.each do |k, v| %><%= hidden_field_tag "fb[#{k}]", v %><% end %>
                          <%= text_area_tag :note, nil, rows: 2, maxlength: 2000,
                              placeholder: "Context for this operation — permanent once saved",
                              class: "border border-gray-300 rounded px-2 py-1 text-sm flex-1" %>
                          <% note_confirm = "Save this note to operation #{position}? Notes are part of the process record and cannot be edited or removed." %>
                          <%= submit_tag "Save note",
                              data: { confirm: note_confirm, turbo_confirm: note_confirm },
                              class: "bg-gray-600 hover:bg-gray-700 text-white text-xs font-medium px-2 py-1.5 rounded" %>
                        <% end %>
                      </details>
                    <% end %>

                    <% if paperless && spec.present? %>
                      <% fields = (spec["fields"] || []).map(&:to_s) %>
                      <% readings = op["ocv_readings"] || {} %>
                      <% checklist_items = OperationLibrary::ContractReviewOperations.resolve_checklist(spec["checklist"]) %>
                      <div class="mt-3 pt-3 border-t border-gray-100">
                        <p class="text-xs font-semibold <%= spec["basis"].to_s == "nadcap" ? "text-amber-700" : "text-gray-600" %> uppercase tracking-wide mb-2">
                          <%= checklist_items.any? ? "Contract Review Checklist" : (spec["basis"].to_s == "nadcap" ? "OCV Monitoring" : "Record") %>
                        </p>
                        <%= form_with url: save_ocv_works_order_path(@works_order), method: :patch, local: true, id: "ocv-form-#{position}" do |f| %>
                          <%= hidden_field_tag :position, position %>
                          <%= hidden_field_tag :batch, active_batch %>
                          <% active_fb.each do |k, v| %><%= hidden_field_tag "fb[#{k}]", v %><% end %>
                          <% if checklist_items.any? %>
                            <% prefill = @works_order.checklist_prefill(op) %>
                            <% answered = checklist_items.count { |i| prefill.dig(i["id"], "answer").present? } %>
                            <% remembered = checklist_items.count { |i| prefill.dig(i["id"], "from_memory") } %>
                            <% current_issue = OperationLibrary::ContractReviewOperations::ISSUE %>
                            <% answered_issue = op["checklist_issue"] %>
                            <% stale_issue = answered_issue.present? && answered_issue != current_issue %>
                            <details class="mb-2 border <%= stale_issue ? "border-amber-400" : "border-gray-200" %> rounded" <%= "open" if answered < checklist_items.length || stale_issue %>>
                              <summary class="cursor-pointer select-none px-3 py-2 text-xs font-medium <%= stale_issue ? "text-amber-800 bg-amber-50" : (answered == checklist_items.length ? "text-green-700 bg-green-50" : "text-gray-700 bg-gray-50") %>">
                                <%= stale_issue ? "⚠" : (answered == checklist_items.length ? "✓" : "▸") %>
                                Checklist (Form <%= OperationLibrary::ContractReviewOperations::FORM %> Iss.<%= current_issue %>): <%= answered %>/<%= checklist_items.length %> answered<%= " (#{remembered} remembered from previous review)" if remembered > 0 %>
                                <% if stale_issue %>
                                  <span class="font-semibold">— answered against Iss.<%= answered_issue %>; re-review against Iss.<%= current_issue %> and save</span>
                                <% end %>
                              </summary>
                              <div class="p-3 space-y-2">
                              <% checklist_items.each_with_index do |item, idx| %>
                                <% r = prefill[item["id"]] || {} %>
                                <div class="flex flex-wrap items-start gap-2 <%= r["from_memory"] ? "opacity-80" : "" %>">
                                  <span class="text-xs text-gray-400 w-5 flex-none pt-1"><%= idx + 1 %></span>
                                  <span class="text-xs text-gray-700 flex-1 min-w-48 pt-1"><%= item["text"] %>
                                    <% if r["from_memory"] %><span class="text-xs text-blue-500">· remembered from WO<%= @works_order.part&.customisation_data&.dig("contract_review_memory", item["id"], "source_wo") %></span><% end %>
                                    <% if item["guidance"].present? %>
                                      <span class="block text-xs italic text-gray-400 mt-0.5"><%= item["guidance"] %></span>
                                    <% end %>
                                  </span>
                                  <%= select_tag "checklist[#{item["id"]}][answer]",
                                      options_for_select(["", "YES", "NO"], r["answer"]),
                                      class: "border border-gray-300 rounded px-1 py-1 text-sm flex-none" %>
                                  <%= text_field_tag "checklist[#{item["id"]}][comment]", r["comment"],
                                      placeholder: "Action taken / comment",
                                      class: "border border-gray-300 rounded px-2 py-1 text-sm w-44 flex-none" %>
                                </div>
                              <% end %>
                              </div>
                            </details>
                            <% completed = op.dig("checklist_completed_by", "name") %>
                            <% if completed %>
                              <p class="mt-1 text-xs text-gray-400">Checklist completed by <%= completed %></p>
                            <% end %>
                          <% end %>
                          <%
                            # Suggestions depend on field + operation text only, never on
                            # the batch - compute once per field, not once per batch.
                            suggestions = fields.index_with { |f| ocv_suggestions(f, op["operation_text"]) }
                          %>
                          <div class="space-y-1">
                            <% if fields.any? %>
                              <% row = readings[active_key] || {} %>
                              <% locked = signed_here %>
                              <% thickness_field = fields.find { |f| FilmThickness::FIELDS.include?(f) } %>
                              <%# The foil-check fields render inside the film thickness card
                                  (film_thickness_field partial), not in this plain row. %>
                              <% foil_fields = thickness_field == FilmThickness::ANODIC_FIELD ? (fields & FilmThicknessHelper::FOIL_CHECK_FIELDS) : [] %>
                              <div class="flex flex-wrap items-center gap-2">
                                <% unless wo_scoped %>
                                  <span class="text-xs text-gray-500 w-14 flex-none">Batch <%= sec_active %></span>
                                <% end %>
                                <% fields.each do |field| %>
                                  <% next if field == thickness_field || foil_fields.include?(field) %>
                                  <label class="flex items-center gap-1 text-xs text-gray-600">
                                    <%= field.humanize %>
                                    <% if field.include?("pass_fail") %>
                                      <%= select_tag "readings[#{active_key}][#{field}]",
                                          options_for_select(["", "PASS", "FAIL"], row[field]),
                                          disabled: locked,
                                          data: { keyflow: "ocv" },
                                          class: "border border-gray-300 rounded px-1 py-1 text-sm #{'bg-gray-100 text-gray-500' if locked}" %>
                                    <% else %>
                                      <% sugg = suggestions[field] %>
                                      <%= text_field_tag "readings[#{active_key}][#{field}]", row[field],
                                          disabled: locked,
                                          data: { keyflow: "ocv" },
                                          class: "border border-gray-300 rounded px-2 py-1 text-sm w-24 #{'bg-gray-100 text-gray-500' if locked}",
                                          autocomplete: "off",
                                          list: (sugg.any? ? "dl-#{position}-#{field}" : nil) %>
                                      <% if sugg.any? %>
                                        <datalist id="dl-<%= position %>-<%= field %>">
                                          <% sugg.each do |s| %><option value="<%= s %>"></option><% end %>
                                        </datalist>
                                      <% end %>
                                    <% end %>
                                  </label>
                                <% end %>
                              </div>
                              <% if thickness_field && !wo_scoped %>
                                <%= render "works_orders/film_thickness_field",
                                    op: op, ops: ops_for_display, position: position,
                                    active_key: active_key, field: thickness_field, row: row,
                                    locked: locked, section_batch: sec_active,
                                    nadcap: FilmThickness.nadcap_for?(op, @works_order.specification),
                                    parts_per_batch: @works_order.section_batch_qty(current_sec, active_key),
                                    foil_fields: foil_fields,
                                    form_id: "ocv-form-#{position}" %>
                              <% end %>

                              <%
                                # Drift context: what the last two recorded batches read.
                                # A paper card gives this by being physically adjacent to
                                # the previous sheet; this is the digital equivalent.
                                recent = readings.reject { |k, _v| k == active_key || k == "wo" }
                                                 .sort_by { |k, _v| -k.to_i }.first(2)
                              %>
                              <% if recent.any? %>
                                <p class="text-xs text-gray-400">
                                  <% recent.each_with_index do |(batch_key, values), i| %>
                                    <%= " · " if i > 0 %>B<%= batch_key %>: <%= fields.map { |f| FilmThickness::FIELDS.include?(f) ? film_thickness_summary(f, values[f]) : (values[f].presence || "—") }.join(" / ") %>
                                  <% end %>
                                </p>
                              <% end %>
                            <% end %>
                          </div>
                          <% recorder = op.dig("ocv_recorded_by", "name") %>
                          <% if recorder %>
                            <p class="mt-1 text-xs text-gray-400">Recorded by <%= recorder %></p>
                          <% end %>
                        <% end %>
                      </div>
                    <% end %>
                  </div>
                  <!-- Sign-off column -->
                  <% if paperless %>
                    <% so = (op["sign_offs"] || {})[active_key] %>
                    <% multi = !wo_scoped && sec_batch_count > 1 %>
                    <div class="flex-none w-32 border-l border-gray-200 flex flex-col items-center justify-center gap-1 p-2 <%= signed_here ? 'bg-green-50' : 'bg-gray-50' %>">
                      <% if so %>
                        <span class="text-xs text-green-700 font-semibold text-center">✓<%= " B#{sec_active}" if multi %> <%= so["name"] %></span>
                        <% if can_undo %>
                          <% undo_confirm = "Undo the sign-off by #{so['name']} on operation #{position}#{wo_scoped ? '' : " batch #{sec_active}"}? The undone signature is kept on the record; re-sign as the right person afterwards." %>
                          <%= button_to "↩ undo", undo_sign_off_works_order_path(@works_order, position: position, batch: active_key,
                                                                                 base_batch: active_batch, fb: active_fb.presence),
                              method: :patch,
                              form: { data: { confirm: undo_confirm, turbo_confirm: undo_confirm } },
                              class: "text-xs text-red-400 hover:text-red-600 underline" %>
                        <% end %>
                      <% elsif !wo_scoped && @works_order.section_batch_qty(current_sec, sec_active).blank? %>
                        <%# The model refuses this sign-off anyway ("a sign-off
                            certifies a complete record"); surface it before the
                            click rather than after. No keyflow tag - the
                            keyboard walk skips straight past. %>
                        <button type="button" disabled data-needs-qty="1"
                                title="Enter a quantity for batch <%= sec_active %> before signing off"
                                class="bg-gray-200 text-gray-400 text-xs font-medium px-2 py-1 rounded cursor-not-allowed">
                          Set batch qty
                        </button>
                      <% elsif spec.present? %>
                        <button type="submit" form="ocv-form-<%= position %>" name="sign_off_batch" value="<%= active_key %>"
                                data-keyflow="signoff"
                                class="bg-gray-700 hover:bg-gray-900 text-white text-xs font-medium px-2 py-1 rounded">
                          Sign off<%= " B#{sec_active}" if multi %>
                        </button>
                      <% else %>
                        <%= button_to (multi ? "Sign off B#{sec_active}" : "Sign off"),
                            sign_off_operation_works_order_path(@works_order, position: position, batch: active_key,
                                                               base_batch: active_batch, fb: active_fb.presence),
                            method: :patch,
                            data: { keyflow: "signoff" },
                            class: "bg-gray-700 hover:bg-gray-900 text-white text-xs font-medium px-2 py-1 rounded" %>
                      <% end %>
                      <% if multi %>
                        <span class="text-xs <%= op_signed ? 'text-green-600' : 'text-gray-500' %>">
                          <%= signed_count %>/<%= op_keys.length %> signed
                        </span>
                      <% end %>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>

        <% else %>
          <div class="flex flex-col items-center justify-center py-16 text-center">
            <svg class="w-12 h-12 text-gray-300 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
            </svg>
            <p class="text-gray-500 font-medium">No operations configured</p>
            <p class="text-sm text-gray-400 mt-1">
              <%= link_to "Set up this part", @works_order.part, class: "text-blue-600 hover:text-blue-900" %> to add processing instructions.
            </p>
          </div>
        <% end %>
      </div>
    </div>

  </div>

  <!-- Customer Order Invoicing Status -->
  <div class="bg-white shadow rounded-lg p-6 mb-6">
    <h2 class="text-xl font-semibold text-gray-900 mb-4">Customer Order Invoicing</h2>
    <dl class="space-y-3">
      <%
        all_customer_order_release_notes = ReleaseNote.joins(:works_order)
                                                      .where(works_orders: { customer_order_id: @works_order.customer_order_id })

        uninvoiced_across_order = all_customer_order_release_notes.requires_invoicing
        invoiced_across_order = all_customer_order_release_notes.joins(:invoice_item)

        uninvoiced_wo_count = @works_order.customer_order.works_orders
                                        .joins(:release_notes)
                                        .merge(ReleaseNote.requires_invoicing)
                                        .distinct.count
      %>

      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <div>
          <dt class="text-sm font-medium text-gray-500">Customer Order</dt>
          <dd class="text-sm text-gray-900">
            <%= link_to @works_order.customer_order.number, @works_order.customer_order,
                class: "text-blue-600 hover:text-blue-900" %>
          </dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-gray-500">WOs with Uninvoiced Items</dt>
          <dd class="text-sm font-semibold <%= uninvoiced_wo_count > 0 ? 'text-orange-600' : 'text-green-600' %>">
            <%= uninvoiced_wo_count %> of <%= @works_order.customer_order.works_orders.active.count %>
          </dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-gray-500">Total Uninvoiced Parts</dt>
          <dd class="text-sm font-semibold <%= uninvoiced_across_order.any? ? 'text-orange-600' : 'text-green-600' %>">
            <%= uninvoiced_across_order.sum(:quantity_accepted) %> parts
            <% if uninvoiced_across_order.any? %>
              <span class="text-xs text-gray-500">(<%= uninvoiced_across_order.count %> notes)</span>
            <% end %>
          </dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-gray-500">Total Invoiced Parts</dt>
          <dd class="text-sm font-semibold text-blue-600">
            <%= invoiced_across_order.sum(:quantity_accepted) %> parts
            <% if invoiced_across_order.any? %>
              <span class="text-xs text-gray-500">(<%= invoiced_across_order.count %> notes)</span>
            <% end %>
          </dd>
        </div>
      </div>

      <% if uninvoiced_across_order.any? %>
        <div class="pt-2">
          <% if uninvoiced_wo_count > 1 %>
            <span class="text-sm text-orange-600 font-medium">⚠️ Ready to invoice entire customer order (<%= uninvoiced_wo_count %> works orders)</span>
          <% else %>
            <span class="text-sm text-orange-600 font-medium">⚠️ Ready to invoice <%= uninvoiced_across_order.sum(:quantity_accepted) %> parts</span>
          <% end %>
        </div>
      <% elsif @works_order.customer_order.works_orders.active.sum(:quantity_released) > 0 %>
        <div class="pt-2">
          <span class="text-sm text-green-600 font-medium">✅ Customer order fully invoiced</span>
        </div>
      <% end %>
    </dl>
  </div>

  <!-- Release Notes -->
  <div class="bg-white shadow rounded-lg p-6">
    <div class="flex justify-between items-center mb-4">
      <h2 class="text-xl font-semibold text-gray-900">Release Notes (This Works Order)</h2>
    </div>

    <% if @works_order.release_notes.any? %>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Number</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Accepted</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Rejected</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Invoice Status</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% @works_order.release_notes.recent.each do |release_note| %>
              <tr class="hover:bg-gray-50">
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">RN<%= release_note.number %></td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900"><%= release_note.date.strftime("%d/%m/%Y") %></td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900"><%= release_note.quantity_accepted %></td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900"><%= release_note.quantity_rejected %></td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <% if release_note.voided %>
                    <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full bg-red-100 text-red-800">Voided</span>
                  <% elsif release_note.invoice_item.present? %>
                    <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full bg-blue-100 text-blue-800">Invoiced</span>
                  <% elsif release_note.can_be_invoiced? %>
                    <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full bg-orange-100 text-orange-800">Ready to Invoice</span>
                  <% else %>
                    <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full bg-gray-100 text-gray-800">No Invoice</span>
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                  <%= link_to "View", release_note, class: "text-blue-600 hover:text-blue-900" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-gray-500">No release notes yet.</p>
    <% end %>
  </div>
</div>

<script>
// Live preview of the batch structure. The point is that the operator sees
// "3000 batches" BEFORE submitting, not after the page tries to render it.
(function () {
  var input = document.getElementById('parts-per-batch');
  var out = document.getElementById('batch-preview');

  // Shared formatter, mirroring WorksOrder#derive_batch_quantities exactly,
  // runt rule included: a final load more than 25% short of capacity
  // balances with the penultimate load (101 at 10 => 9 × 10, then 6 + 5).
  // The keyflow dropdown labels its parts-per-batch suggestions with the
  // same text, so the two can never drift.
  window.__hamsBatchStructure = function (per, total, max) {
    if (!per || per < 1 || !total) return null;
    if (per > total) return { text: 'More than the order quantity (' + total + ')', warn: true };
    var count = Math.ceil(total / per);
    var remainder = total - per * (count - 1);
    if (count > max) return { text: count + ' batches — over the limit of ' + max, warn: true };
    var text;
    if (remainder === per) {
      text = count + ' × ' + per;
    } else if (count > 1 && remainder < per * 0.75) {
      var combined = per + remainder;
      var a = Math.ceil(combined / 2), b = combined - a;
      var full = count - 2;
      text = (full > 0 ? full + ' × ' + per + ', then ' : '') + a + ' + ' + b + ' (last two balanced)';
    } else {
      text = (count - 1) + ' × ' + per + ' + 1 × ' + remainder;
    }
    return { text: text, warn: false };
  };

  if (!input || !out) return;
  function preview() {
    var s = window.__hamsBatchStructure(
      parseInt(input.value, 10),
      parseInt(input.dataset.quantity, 10),
      parseInt(input.dataset.maxBatches, 10)
    );
    if (!s) { out.textContent = ''; out.className = 'text-xs text-gray-500'; return; }
    out.textContent = s.text;
    out.className = s.warn ? 'text-xs text-orange-600 font-medium' : 'text-xs text-gray-500';
  }
  input.addEventListener('input', preview);
  preview();
})();

// Keep the operation you acted on under your finger. Turbo preserves the pixel
// scroll offset across a morph, which is not the same thing: signing off
// contract review collapses a 17-item checklist, the page above the viewport
// gets shorter, and everything slides up. So record where the row sat before
// submitting and put it back there afterwards. Only applies when the URL is
// unchanged - moving to the next batch is a real navigation and should land at
// the top of the card.
(function () {
  if (window.__hamsOpScrollPin) return;
  window.__hamsOpScrollPin = true;

  var pin = null;

  document.addEventListener('turbo:submit-start', function (event) {
    var form = event.target;
    var row = form && form.closest ? form.closest("[id^='op-']") : null;
    pin = row ? { id: row.id, top: row.getBoundingClientRect().top, url: window.location.href } : null;
  });

  function restore() {
    var target = pin;
    pin = null;
    if (!target || window.location.href !== target.url) return;

    // After Turbo's own scroll restoration, not before it.
    requestAnimationFrame(function () {
      var row = document.getElementById(target.id);
      if (row) window.scrollBy(0, row.getBoundingClientRect().top - target.top);
    });
  }

  document.addEventListener('turbo:morph', restore);
  document.addEventListener('turbo:load', restore);
})();

// On a phone the layout stacks and the operations card sits below every
// detail panel - the thing the operator came for starts two screens down.
// Jump straight to it on arrival. Real navigations only: a same-URL morph
// (signing off, saving readings) must never yank the view - the scroll-pin
// above owns that case - so any submit or morph marks the next settle as
// skipped. The lg breakpoint (1024px) is where the two-column layout kicks
// in and the card is already beside the details.
(function () {
  if (window.__hamsMobileOpsJump) return;
  window.__hamsMobileOpsJump = true;

  var skip = false;
  document.addEventListener('turbo:submit-start', function () { skip = true; });
  document.addEventListener('turbo:morph', function () { skip = true; });

  function jump() {
    var wasSkip = skip;
    skip = false;
    if (wasSkip) return;
    if (window.innerWidth >= 1024) return;
    var card = document.getElementById('process-operations-card');
    if (card) card.scrollIntoView({ block: 'start' });
  }

  document.addEventListener('turbo:load', jump);
  if (document.readyState !== 'loading') { jump(); }
  else { document.addEventListener('DOMContentLoaded', jump); }
})();

// Keyboard sign-off flow. The operator works the card without touching the
// mouse: focus starts at the first actionable spot on the first unsigned op
// - an empty OCV field if the op has one, otherwise its sign-off button.
//   On a sign-off button:  Enter/Space = sign off (native click);
//                          any other key = skip to the next unsigned op
//                          (ArrowUp goes back) without doing anything.
//   On an OCV field:       an empty field opens the suggestions dropdown
//                          immediately, MIDDLE option pre-highlighted
//                          (mid-range is "done normally"; the bare minimum
//                          would be the least defensible auto-pick).
//                          Arrows move the highlight, typing filters,
//                          Enter accepts the highlight and walks on - to
//                          the op's next empty field, or, once every field
//                          is recorded, straight to signing off. Escape
//                          closes the dropdown; Escape again skips to the
//                          next op.
// Suggestions are a custom dropdown, not the native datalist - browsers
// refuse to open a datalist on programmatic focus and offer no way to
// pre-highlight an option, which is the whole point here. The datalists
// stay in the markup for touch devices; on desktop their options are
// lifted out and the list attribute removed.
// Enter never implicitly submits a half-recorded OCV form any more - the
// handler owns the key. Rows without an enabled sign-off button (signed
// already, or waiting on a batch quantity) are invisible to the walk.
(function () {
  if (window.__hamsKeyflow) return;
  window.__hamsKeyflow = true;

  var deskop = window.matchMedia && window.matchMedia('(hover: hover) and (pointer: fine)').matches;

  function rows() {
    return Array.prototype.filter.call(
      document.querySelectorAll("[id^='op-']"),
      function (row) { return row.querySelector('[data-keyflow="signoff"]:not([disabled])'); }
    );
  }
  function ocvFields(row) {
    return Array.prototype.slice.call(row.querySelectorAll('[data-keyflow="ocv"]:not([disabled])'));
  }
  function stationFor(row) {
    var empty = ocvFields(row).filter(function (f) { return !f.value; })[0];
    return empty || row.querySelector('[data-keyflow="signoff"]:not([disabled])');
  }
  function ring(row) {
    Array.prototype.forEach.call(document.querySelectorAll("[id^='op-']"), function (r) {
      r.classList.remove('ring-2', 'ring-blue-500', 'shadow-lg');
      r.classList.add('transition-opacity', 'duration-150');
      r.classList.toggle('opacity-40', !!row && r !== row && !row.hasAttribute('data-keep-context'));
    });
    if (row) row.classList.add('ring-2', 'ring-blue-500', 'shadow-lg');
  }
  function focusStation(el, center) {
    if (!el) return;
    el.focus({ preventScroll: true });
    var row = el.closest("[id^='op-']");
    if (row) { row.scrollIntoView({ block: center ? 'center' : 'nearest' }); ring(row); }
  }
  // One-time coaching banner: server renders #keyflow-hint (hidden) on every
  // paperless card. Slot it into the top of the first focused op and reveal
  // it - but only until the operator makes their first sign-off of this
  // browser session (flag below), after which it stays hidden across the
  // morphs/reloads that follow every sign-off.
  var HINT_KEY = 'hamsKeyflowHintDone';
  function placeHint(row) {
    var hint = document.getElementById('keyflow-hint');
    if (!hint || !row) return;
    try { if (sessionStorage.getItem(HINT_KEY)) return; } catch (e) {}
    if (hint.parentNode !== row) row.insertBefore(hint, row.firstChild);
    hint.classList.remove('hidden');
  }
  // Any sign-off - clicked, Enter/Space, or reached via the OCV walk (which
  // ends in btn.click()) - retires the hint for the rest of the session.
  document.addEventListener('click', function (e) {
    if (!e.target || !e.target.closest) return;
    if (e.target.closest('[data-keyflow="signoff"]')) {
      try { sessionStorage.setItem(HINT_KEY, '1'); } catch (e2) {}
      var hint = document.getElementById('keyflow-hint');
      if (hint) hint.classList.add('hidden');
    }
  });
  function focusFirst() {
    var r = rows();
    if (r.length) { placeHint(r[0]); focusStation(stationFor(r[0]), false); return; }
    // Nothing signable, but ops are waiting on batch quantities - exactly
    // the state after the two WO-scoped ops on a fresh works order. Send
    // the operator to batching; the reload after "Set batches" walks
    // straight on to the next op.
    if (document.querySelector('[data-needs-qty]')) {
      var ppb = document.getElementById('parts-per-batch');
      if (ppb) { ppb.focus({ preventScroll: true }); ppb.scrollIntoView({ block: 'center' }); }
    }
  }
  function moveRow(fromEl, dir) {
    var r = rows();
    var row = fromEl.closest("[id^='op-']");
    var i = r.indexOf(row);
    var next = r[i + dir] || (i === -1 && dir === 1 ? r[0] : null);
    if (next) focusStation(stationFor(next), true);
  }

  // ---- Custom suggestion dropdown -----------------------------------------
  var dd = null, ddItems = [], ddIndex = -1, ddFor = null;

  function closeDD() {
    if (dd) dd.remove();
    dd = null; ddItems = []; ddIndex = -1; ddFor = null;
  }
  function paintDD() {
    Array.prototype.forEach.call(dd.children, function (row, j) {
      row.className = 'px-3 py-1.5 cursor-pointer' + (j === ddIndex ? ' bg-blue-600 text-white' : '');
    });
  }
  function openDD(input, filter) {
    var all = input.__sugg || [];
    var q = (filter || '').toLowerCase();
    var items = q
      ? all.filter(function (it) { return (String(it.v) + ' ' + it.label).toLowerCase().indexOf(q) !== -1; })
      : all;
    closeDD();
    if (!items.length) return;
    dd = document.createElement('div');
    dd.className = 'fixed z-50 bg-white border border-gray-300 rounded shadow-lg text-sm max-h-64 overflow-y-auto';
    var r = input.getBoundingClientRect();
    dd.style.left = r.left + 'px';
    dd.style.top = (r.bottom + 2) + 'px';
    dd.style.minWidth = r.width + 'px';
    ddItems = items; ddFor = input;
    if (q) {
      ddIndex = 0;
    } else if (input.dataset.keyflow === 'ppb') {
      // Highlight the option matching the (prefilled) value - the full
      // quantity on a fresh works order - falling back to the top.
      var cur = parseInt(input.value, 10);
      var m = items.findIndex(function (it) { return parseInt(it.v, 10) === cur; });
      ddIndex = m >= 0 ? m : 0;
    } else {
      ddIndex = Math.floor((items.length - 1) / 2);
    }
    items.forEach(function (it) {
      var row = document.createElement('div');
      row.textContent = it.label;
      row.addEventListener('mousedown', function (e) {
        e.preventDefault(); // keep focus on the input
        input.value = it.v;
        closeDD();
      });
      dd.appendChild(row);
    });
    paintDD();
    document.body.appendChild(dd);
  }
  function highlight(i) {
    if (!dd || !ddItems.length) return;
    ddIndex = (i + ddItems.length) % ddItems.length;
    paintDD();
    dd.children[ddIndex].scrollIntoView({ block: 'nearest' });
  }

  // Lift datalist options onto the inputs and take over (desktop only -
  // touch keeps the native, OS-integrated datalist UI).
  function enhance() {
    Array.prototype.forEach.call(document.querySelectorAll('[data-keyflow="ocv"][list]'), function (input) {
      var dl = input.list;
      if (!dl) return;
      input.__sugg = Array.prototype.map.call(dl.options, function (o) { return { v: o.value, label: o.value }; });
      input.removeAttribute('list');
    });
  }

  // Enter's walk: next empty field of the op, or sign off once complete.
  function advance(t) {
    if (!t.value) { if (t.__sugg) openDD(t); return; } // nothing to accept - reopen and stay
    var row = t.closest("[id^='op-']");
    var nextEmpty = ocvFields(row).filter(function (f) { return f !== t && !f.value; })[0];
    if (nextEmpty) { nextEmpty.focus({ preventScroll: true }); return; }
    var btn = row.querySelector('[data-keyflow="signoff"]:not([disabled])');
    if (btn) btn.click();
  }

  var MODIFIERS = { Shift: 1, Control: 1, Alt: 1, Meta: 1, CapsLock: 1 };

  document.addEventListener('keydown', function (e) {
    var t = e.target;
    if (!t || !t.dataset || e.metaKey || e.ctrlKey || e.altKey) return;

    if (t.dataset.keyflow === 'signoff') {
      if (e.key === 'Enter' || e.key === ' ' || e.key === 'Tab' || MODIFIERS[e.key]) return;
      e.preventDefault();
      moveRow(t, e.key === 'ArrowUp' ? -1 : 1);
      return;
    }

    if (t.dataset.keyflow === 'ocv' || t.dataset.keyflow === 'ppb') {
      if (dd && ddFor === t) {
        if (e.key === 'ArrowDown') { e.preventDefault(); highlight(ddIndex + 1); return; }
        if (e.key === 'ArrowUp')   { e.preventDefault(); highlight(ddIndex - 1); return; }
        if (e.key === 'Escape')    { e.preventDefault(); closeDD(); return; }
        if (e.key === 'Enter') {
          e.preventDefault();
          if (ddIndex >= 0) t.value = ddItems[ddIndex].v;
          closeDD();
          if (t.dataset.keyflow === 'ppb') {
            if (t.form) (t.form.requestSubmit ? t.form.requestSubmit() : t.form.submit());
          } else {
            advance(t);
          }
          return;
        }
        return; // typing refilters via the input listener
      }
      if (t.dataset.keyflow === 'ppb') return; // dropdown closed: native Enter submits the form
      if (e.key === 'Escape') { e.preventDefault(); moveRow(t, 1); return; }
      if (e.key !== 'Enter') return; // normal typing
      e.preventDefault();            // never implicitly submit a partial form
      advance(t);
    }
  });

  document.addEventListener('input', function (e) {
    var t = e.target;
    if (t && t.dataset && t.dataset.keyflow === 'ocv' && t.__sugg) openDD(t, t.value);
  });

  // Parts-per-batch suggestions: the full quantity (one batch of the lot)
  // plus even 2..5-way splits, each labelled with the exact structure the
  // server will derive - via the shared formatter, so label and outcome
  // can never disagree.
  function ppbSuggestions(input) {
    if (input.__sugg) return;
    var total = parseInt(input.dataset.quantity, 10);
    var max = parseInt(input.dataset.maxBatches, 10);
    if (!total) return;
    var seen = {}, items = [];
    [1, 2, 3, 4, 5].forEach(function (ways) {
      var per = Math.ceil(total / ways);
      if (per < 1 || seen[per]) return;
      var s = window.__hamsBatchStructure ? window.__hamsBatchStructure(per, total, max) : null;
      if (!s || s.warn) return;
      seen[per] = 1;
      items.push({ v: per, label: per + ' per batch — ' + s.text });
    });
    if (items.length) input.__sugg = items;
  }

  document.addEventListener('focusin', function (e) {
    var t = e.target;
    if (t && t.dataset && t.dataset.keyflow) {
      ring(t.closest("[id^='op-']"));
      if (t.dataset.keyflow === 'ocv' && t.__sugg && !t.value) openDD(t);
      if (t.dataset.keyflow === 'ppb') { ppbSuggestions(t); if (t.__sugg) { t.select(); openDD(t); } }
    } else {
      // Working elsewhere. If it's still inside an op (thickness card,
      // notes), keep that op ringed so the walk visibly follows the
      // operator; only undim when focus leaves the ops entirely.
      var row = t && t.closest ? t.closest("[id^='op-']") : null;
      ring(row);
      closeDD();
    }
  });

  // Clicking an op's body (not one of its controls) hands the Enter-walk to
  // that op: focus lands on its first empty OCV field or its sign-off
  // button, and the walk continues from there instead of going dead. If the
  // clicked op has nothing signable (already signed), the walk resumes at
  // the next signable op after it.
  document.addEventListener('mousedown', function (e) {
    if (!deskop || !e.target || !e.target.closest) return;
    var row = e.target.closest("[id^='op-']");
    if (!row) return;
    if (e.target.closest('input, select, textarea, button, a, label, summary, details, [contenteditable]')) return;
    var r = rows();
    var target = r.indexOf(row) !== -1 ? row : r.filter(function (cand) {
      return row.compareDocumentPosition(cand) & Node.DOCUMENT_POSITION_FOLLOWING;
    })[0];
    if (!target) return;
    e.preventDefault(); // beat the blur-to-body, keep the station focus clean
    focusStation(stationFor(target), false);
  });
  document.addEventListener('focusout', function (e) {
    if (ddFor && e.target === ddFor) {
      setTimeout(function () { if (document.activeElement !== ddFor) closeDD(); }, 0);
    }
  });
  // Track the input on scroll rather than closing - closing would also kill
  // the dropdown the instant autofocus scrolls its own row into view.
  function repositionDD() {
    if (!dd || !ddFor) return;
    var r = ddFor.getBoundingClientRect();
    dd.style.left = r.left + 'px';
    dd.style.top = (r.bottom + 2) + 'px';
  }
  document.addEventListener('scroll', repositionDD, true);
  document.addEventListener('turbo:submit-start', closeDD);

  function arm() {
    if (!deskop) return;
    enhance();
    focusFirst();
  }
  document.addEventListener('turbo:load', arm);
  document.addEventListener('turbo:morph', function () { closeDD(); setTimeout(arm, 0); });
  if (document.readyState !== 'loading') { arm(); }
  else { document.addEventListener('DOMContentLoaded', arm); }
})();

function printRouteCard(url) {
  const printWindow = window.open(url, '_blank', 'width=800,height=600');
  printWindow.onload = function() {
    printWindow.print();
  };
}
</script>
