<%# app/views/works_orders/_batch_shares.html.erb
    Per-member split of one batch on a process group lead's record: how many
    of each works order's parts are on this load. Rendered inside the
    set_batch_qty form, so the selects post as shares[WO1234]=40 alongside
    :batch. The lead's form posts NO qty: the batch qty is the sum of the
    split (set_batch_qty! derives it). Each member's dropdown runs from its
    unallocated count in this section (WO qty less its shares on the other
    batches) down to 0, so the split can never over-commit a works order.
    All zero = unsplit, the batch certifies the bar as a whole. The sum is
    echoed live.

    Locals: section (hash), batch (number/string). %>
<% shares  = @works_order.section_batch_shares(section, batch) || {} %>
<% members = @works_order.process_group.members.where(voided: false) %>
<% uid     = "shares_#{section['key'].to_s.parameterize}_#{batch}" %>
<span class="text-xs text-gray-500 ml-1">split:</span>
<span class="inline-flex items-center gap-2" data-batch-shares="<%= uid %>">
  <% members.each do |m| %>
    <% cap = @works_order.member_unallocated_in_section(section, batch, m.display_name, m.quantity) %>
    <% cap = [cap, shares[m.display_name].to_i].max %>
    <label class="text-xs text-gray-700 inline-flex items-center gap-1"
           title="<%= m.display_name %> · <%= m.part_number %> (qty <%= m.quantity %>, <%= cap %> not yet on another batch)">
      <%= m.display_name %>
      <%= select_tag "shares[#{m.display_name}]",
          options_for_select(cap.downto(0).map { |q| [q, q] }, shares[m.display_name].to_i),
          id: nil,
          onchange: "hamsBatchShareSum('#{uid}')",
          class: "border border-gray-300 rounded px-1 py-1 text-sm" %>
    </label>
  <% end %>
  <span class="text-xs" id="<%= uid %>_sum"
        title="Batch qty = the split total. Leave every box at 0 to record the load as one figure (unsplit).">
    <% total = shares.values.sum %>
    <% if shares.empty? %>
      <span class="text-gray-400">unsplit</span>
    <% else %>
      = <%= total %>
    <% end %>
  </span>
</span>
