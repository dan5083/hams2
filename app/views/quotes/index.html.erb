<div class="container mx-auto px-4 py-6">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold text-gray-900">Quotes</h1>
    <p class="text-sm text-gray-500">Raised via the HAMS Assistant from drawings and enquiries.</p>
  </div>

  <%= form_with url: quotes_path, method: :get, local: true, class: "flex flex-wrap gap-2 mb-4 items-center" do %>
    <%= select_tag :status, options_for_select([["All statuses", ""]] + Quote::STATUSES.map { |s| [s.titleize, s] }, params[:status]),
        class: "border border-gray-300 rounded px-2 py-1 text-sm", onchange: "this.form.requestSubmit()" %>
    <%= select_tag :customer_id, options_from_collection_for_select(@customers, :id, :name, params[:customer_id]),
        prompt: "All customers", class: "border border-gray-300 rounded px-2 py-1 text-sm", onchange: "this.form.requestSubmit()" %>
  <% end %>

  <div class="bg-white shadow rounded-lg overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <% %w[Quote Customer Title Total Status Raised Sent].each do |h| %>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= h %></th>
          <% end %>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200">
        <% @quotes.each do |q| %>
          <tr class="hover:bg-gray-50">
            <td class="px-4 py-3 text-sm font-medium"><%= link_to q.display_name, q, class: "text-blue-600 hover:text-blue-900" %></td>
            <td class="px-4 py-3 text-sm text-gray-900"><%= q.customer.name %></td>
            <td class="px-4 py-3 text-sm text-gray-700 max-w-md truncate" title="<%= q.title %>"><%= q.title %></td>
            <td class="px-4 py-3 text-sm text-right tabular-nums">£<%= '%.2f' % q.total_ex_tax %></td>
            <td class="px-4 py-3 text-sm">
              <% colour = { "draft" => "bg-gray-100 text-gray-800", "sent" => "bg-blue-100 text-blue-800", "won" => "bg-green-100 text-green-800", "lost" => "bg-red-100 text-red-800" }[q.status] %>
              <span class="inline-flex px-2 py-0.5 text-xs font-semibold rounded-full <%= colour %>"><%= q.status.titleize %></span>
            </td>
            <td class="px-4 py-3 text-sm text-gray-500 whitespace-nowrap"><%= q.created_at.strftime("%d/%m/%Y") %><%= " · #{q.created_by.display_name}" if q.created_by %></td>
            <td class="px-4 py-3 text-sm text-gray-500 whitespace-nowrap"><%= q.sent_at&.strftime("%d/%m/%Y") || "—" %></td>
          </tr>
        <% end %>
        <% if @quotes.empty? %>
          <tr><td colspan="7" class="px-4 py-8 text-center text-sm text-gray-500">No quotes yet.</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <div class="mt-4"><%= paginate @quotes if respond_to?(:paginate) %></div>
</div>
