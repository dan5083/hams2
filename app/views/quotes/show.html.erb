<% provide :title, "#{@quote.display_name} · #{@quote.customer.name}" %>
<div class="container mx-auto px-4 py-6 max-w-5xl">
  <div class="flex justify-between items-start mb-6">
    <div>
      <h1 class="text-3xl font-bold text-gray-900">Quote <%= @quote.display_name %></h1>
      <p class="text-sm text-gray-600 mt-1"><%= link_to @quote.customer.name, organization_path(@quote.customer), class: "hover:text-blue-700" %><%= " — #{@quote.title}" if @quote.title.present? %></p>
    </div>
    <div class="flex space-x-2">
      <%= link_to "PDF", quote_path(@quote, format: :pdf), target: "_blank",
          class: "bg-gray-600 hover:bg-gray-700 text-white font-bold py-2 px-4 rounded" %>
      <%= link_to "Back to Quotes", quotes_path, class: "bg-gray-500 hover:bg-gray-700 text-white font-bold py-2 px-4 rounded" %>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="lg:col-span-2 space-y-6">
      <div class="bg-white shadow rounded-lg overflow-hidden">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Part</th>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Description</th>
              <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">Qty</th>
              <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">Unit</th>
              <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">Total</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200">
            <% @quote.quote_items.each do |item| %>
              <tr>
                <td class="px-4 py-3 text-sm whitespace-nowrap">
                  <% if item.part %>
                    <%= link_to item.part.display_name, item.part, class: "text-blue-600 hover:text-blue-900 font-medium" %>
                    <% if item.part.has_previewable_files? %><span class="ml-1 text-xs text-gray-400" title="Drawing on file">📎<%= item.part.files.length %></span><% end %>
                  <% else %><span class="text-gray-400">—</span><% end %>
                </td>
                <td class="px-4 py-3 text-sm text-gray-800 whitespace-pre-line"><%= item.description %></td>
                <td class="px-4 py-3 text-sm text-right tabular-nums"><%= item.quantity %></td>
                <td class="px-4 py-3 text-sm text-right tabular-nums">£<%= '%.2f' % item.unit_amount %></td>
                <td class="px-4 py-3 text-sm text-right tabular-nums font-medium">£<%= '%.2f' % item.line_total %></td>
              </tr>
            <% end %>
          </tbody>
          <tfoot class="bg-gray-50">
            <tr>
              <td colspan="4" class="px-4 py-3 text-sm font-semibold text-right">Total ex VAT</td>
              <td class="px-4 py-3 text-sm font-bold text-right tabular-nums">£<%= '%.2f' % @quote.total_ex_tax %></td>
            </tr>
          </tfoot>
        </table>
      </div>

      <% if @quote.summary.present? || @quote.notes.present? %>
        <div class="bg-white shadow rounded-lg p-4 text-sm text-gray-800 space-y-2">
          <% if @quote.summary.present? %><p><span class="font-medium text-gray-500">Process:</span> <%= @quote.summary %></p><% end %>
          <% if @quote.notes.present? %><p class="whitespace-pre-line"><%= @quote.notes %></p><% end %>
        </div>
      <% end %>
    </div>

    <div class="space-y-6">
      <div class="bg-white shadow rounded-lg p-4">
        <dl class="space-y-3 text-sm">
          <div><dt class="text-gray-500">Status</dt>
            <dd>
              <% colour = { "draft" => "bg-gray-100 text-gray-800", "sent" => "bg-blue-100 text-blue-800", "won" => "bg-green-100 text-green-800", "lost" => "bg-red-100 text-red-800" }[@quote.status] %>
              <span class="inline-flex px-2 py-0.5 text-xs font-semibold rounded-full <%= colour %>"><%= @quote.status.titleize %></span>
            </dd></div>
          <div><dt class="text-gray-500">Enquirer</dt>
            <dd class="text-gray-900"><%= @quote.enquirer_name.presence %><%= " · " if @quote.enquirer_name.present? && @quote.enquirer_email.present? %><%= mail_to(@quote.enquirer_email) if @quote.enquirer_email.present? %><%= "—" if @quote.enquirer_name.blank? && @quote.enquirer_email.blank? %></dd></div>
          <div><dt class="text-gray-500">Raised</dt><dd class="text-gray-900"><%= @quote.created_at.strftime("%d/%m/%Y %H:%M") %><%= " by #{@quote.created_by.display_name}" if @quote.created_by %></dd></div>
          <div><dt class="text-gray-500">Valid until</dt><dd class="text-gray-900"><%= @quote.valid_until&.strftime("%d/%m/%Y") %></dd></div>
          <% if @quote.sent_at %>
            <div><dt class="text-gray-500">Sent</dt><dd class="text-gray-900"><%= @quote.sent_at.strftime("%d/%m/%Y %H:%M") %><br><span class="text-xs text-gray-500"><%= @quote.sent_to.join(", ") %></span></dd></div>
          <% end %>
        </dl>
      </div>

      <div class="bg-white shadow rounded-lg p-4 space-y-3">
        <%= form_with url: send_email_quote_path(@quote), method: :post, local: true, class: "space-y-2" do %>
          <label class="block text-xs font-medium text-gray-500">Send to</label>
          <%= email_field_tag :to, @quote.enquirer_email, placeholder: "enquirer@customer.com", required: true,
              class: "border border-gray-300 rounded px-2 py-1 text-sm w-full" %>
          <button type="submit" class="w-full bg-blue-600 hover:bg-blue-800 text-white font-bold py-2 px-4 rounded"
                  data-disable-with="Sending…" data-turbo-confirm="Email <%= @quote.display_name %> with the PDF and <%= @quote.attachable_part_files.length %> drawing(s)?">
            <%= @quote.sent? ? "Re-send" : "Send" %> quote
          </button>
        <% end %>
        <div class="flex gap-2 pt-2 border-t border-gray-200">
          <% (%w[draft sent won lost] - [@quote.status]).each do |s| %>
            <%= button_to "Mark #{s}", update_status_quote_path(@quote, status: s), method: :patch,
                class: "flex-1 bg-gray-100 hover:bg-gray-200 text-gray-800 text-xs font-medium py-1.5 px-2 rounded" %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
