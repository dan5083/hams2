<%# app/views/quotes/new.html.erb — start a quote: drawings + the enquiry.
    No fields to fill: the assistant reads customer, enquirer, part, spec and
    quantities out of the paste / PDF and proposes them on the build page. %>
<div class="w-full px-6 py-6 max-w-5xl">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold text-gray-900">New Quote</h1>
    <%= link_to "Back to Quotes", quotes_path, class: "text-sm text-blue-600 hover:text-blue-900" %>
  </div>

  <% if @quote.errors.any? %>
    <div class="bg-red-50 border border-red-200 text-red-800 rounded p-3 mb-4 text-sm">
      <%= @quote.errors.full_messages.join("; ") %>
    </div>
  <% end %>

  <%# Drawings always go to Cloudinary (our account, attached to the part,
      sent out with the quote). Ticking ITAR below keeps them off the
      external model: the assistant then works from the enquiry text and the
      reviewer's description of the drawing instead. %>
  <div class="bg-red-50 border-2 border-red-300 rounded-lg p-4 mb-4">
    <p class="text-red-800 font-bold">ITAR / export-controlled drawings: tick the box below.</p>
    <p class="text-sm text-red-700 mt-1">Drawings uploaded here are stored in Cloudinary and, unless the quote is marked ITAR, sent to an external AI service to read. Marking it ITAR keeps every file in our own systems — the assistant only sees the enquiry text and your description.</p>
  </div>

  <div class="bg-blue-50 border border-blue-200 rounded-lg p-4 mb-4 text-sm text-blue-900">
    <p class="font-semibold mb-1">What the paste or the PDF needs to contain</p>
    <p class="text-blue-800 mb-2">The assistant fills the quote from these. Anything missing becomes a question on the next page, so the more of it is in here the less you type later.</p>
    <ul class="list-disc pl-5 space-y-0.5">
      <li><strong>Who is asking</strong> — company, contact name and email (the sender block of the email is enough).</li>
      <li><strong>Part number and issue / revision</strong> — on the drawing title block or in the email.</li>
      <li><strong>Specification and process</strong> — DEF STAN / MIL spec, thickness or build-up, sealing, dye, colour.</li>
      <li><strong>Material</strong> — the alloy (6082, 7075-T6, 2024…).</li>
      <li><strong>Quantities</strong> — and any price breaks they want.</li>
      <li><strong>Masking</strong> — any faces, bores or areas the drawing marks as free of coating.</li>
      <li><strong>End user / prime</strong> — if the work is ultimately for Ultra, Cobham or Eaton, it should be visible on the drawing or stated in the email.</li>
      <li><strong>Anything they said</strong> — deadline, previous quote reference, "same as last time".</li>
    </ul>
  </div>

  <%= form_with model: @quote, url: quotes_path, local: true, multipart: true, data: { turbo: false }, class: "bg-white shadow rounded-lg p-6 space-y-5" do |f| %>
    <div>
      <%= f.label :drawings, "Drawings / enquiry documents (PDF, JPG, PNG)", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.file_field :drawings, multiple: true, accept: "application/pdf,image/*", required: true,
          class: "block w-full text-sm text-gray-700 file:mr-3 file:py-2 file:px-3 file:rounded file:border-0 file:bg-blue-50 file:text-blue-700" %>
      <p class="text-xs text-gray-500 mt-1">An emailed RFQ saved as PDF works here on its own. Drawings are attached to the part(s) created when you save, and go out with the quote email.</p>
    </div>

    <div class="border border-red-200 rounded-lg p-4 bg-red-50/40">
      <label class="flex items-start space-x-3 cursor-pointer">
        <%= f.check_box :itar, class: "mt-1 h-4 w-4 text-red-600 border-gray-300 rounded",
            onchange: "document.getElementById('itar-description').classList.toggle('hidden', !this.checked); document.getElementById('quote_drawing_description').required = this.checked;" %>
        <span>
          <span class="block text-sm font-semibold text-gray-900">ITAR / export-controlled — do not send the drawings to the assistant</span>
          <span class="block text-xs text-gray-600 mt-0.5">The files still upload, attach to the part(s) and go out with the quote email as normal. Only the AI never sees them.</span>
        </span>
      </label>
      <div id="itar-description" class="mt-3 <%= 'hidden' unless @quote.itar? %>">
        <%= f.label :drawing_description, "Describe the drawing(s) for the assistant", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_area :drawing_description, rows: 8, required: @quote.itar?,
            class: "border border-gray-300 rounded px-3 py-2 w-full font-mono text-sm",
            placeholder: "What the assistant would otherwise read off the drawing — keep it functional, not geometric:\n\n- Part number and issue (title block)\n- Material / alloy\n- Spec callouts: process, thickness, seal, dye/colour, any standard quoted\n- Masking: faces, bores or threads marked free of coating\n- Jigging: holes or features it can be hung from, surfaces that must not be contacted\n- Rough size / weight class if it affects jigging\n- End user / prime if shown" %>
        <p class="text-xs text-gray-500 mt-1">This is stored on the quote and shown on the workbench; you can correct it before a re-run.</p>
      </div>
    </div>

    <div>
      <%= f.label :enquiry, "Enquiry text", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_area :enquiry, rows: 10, class: "border border-gray-300 rounded px-3 py-2 w-full font-mono text-sm",
          placeholder: "Paste the whole customer email here, sender block included — quantities, spec, deadline, anything they said." %>
    </div>

    <div class="flex justify-end space-x-2 pt-2">
      <%= link_to "Cancel", quotes_path, class: "bg-gray-200 hover:bg-gray-300 text-gray-800 font-bold py-2 px-4 rounded" %>
      <button type="submit" class="bg-blue-600 hover:bg-blue-800 text-white font-bold py-2 px-4 rounded" data-disable-with="Uploading…">
        Analyse &amp; propose
      </button>
    </div>
  <% end %>
</div>
