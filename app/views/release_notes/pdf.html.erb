<%# app/views/release_notes/pdf.html.erb
    Single release note document:
      - Proof of Collection (consolidated advice note) — ONLY on the "lead"
        release note for the customer order (lowest-numbered active one), and
        never on emailed copies (for_email: true — nothing for a driver to
        sign on an attachment).
      - Certificate of Conformity — always.
    The heavy lifting lives in the shared partials (_pdf_styles,
    _proof_of_collection, _certificate) so the customer-order collection pack
    (customer_orders/collection_pack.html.erb) can compile the same pages for
    every release note on an order in one Grover render. %>
<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <%= render "release_notes/pdf_styles" %>
  </head>
  <body>
    <%
      customer_order = @release_note.works_order.customer_order
      is_advice_lead = customer_order.lead_release_note&.id == @release_note.id

      # Emailed copies (order-complete notification attachments) carry ONLY the
      # Certificate of Conformity: no Proof of Collection page (nothing for a
      # driver to sign). Web/print renders don't pass this local, so nothing
      # changes there.
      for_email = local_assigns.fetch(:for_email, false)
    %>
    <% if is_advice_lead && !for_email %>
      <%= render "release_notes/proof_of_collection",
                 customer_order: customer_order,
                 release_note: @release_note %>
    <% end %>

    <%= render "release_notes/certificate", release_note: @release_note %>
  </body>
</html>
