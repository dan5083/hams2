<%# app/views/release_notes/_proof_of_collection.html.erb
    Consolidated advice note ("Proof of Collection") for a customer order.
    Locals:
      customer_order - the order being collected
      release_note   - the lead release note (carries the RN number + date
                       shown on the advice note; see CustomerOrder#lead_release_note)
    One row per active works order on the order, one driver signature per
    collection. Extracted verbatim from release_notes/pdf.html.erb. %>
<div class="advice-note">
        <div class="logo-header">
          <%# Inlined as a data URI (PdfHelper) so Grover's Chromium never makes a
              network request back to the dyno — fixes the logo not rendering in
              compiled packs and shaves the asset round-trip off render time. %>
          <img src="<%= pdf_logo_data_uri %>" alt="Hard Anodising Surface Treatments Ltd">
          <div class="company-contact">
            Firs Industrial Estate, Rickets Close, Kidderminster DY11 7QN<br/>
            Tel: 01562 747100 | <a href="https://www.hard-anodising.co.uk/">www.hard-anodising.co.uk</a>
          </div>
        </div>

        <h1>Proof of Collection RN<%= release_note.number %></h1>

        <table class="header-table">
          <tbody>
            <tr><th>Customer Order</th><td><%= customer_order.number %></td></tr>
            <tr><th>Date</th><td><%= release_note.date.strftime("%d/%m/%Y") %></td></tr>
          </tbody>
        </table>

        <%# Single customer block — the old Invoice To / Deliver To pair was
            always the same address twice. Name kept large and bold so the
            driver/goods-in can see whose collection this is at a glance. %>
        <div class="customer-block">
          <div class="customer-name"><%= customer_order.customer.display_name %></div>
          <%= simple_format(customer_order.customer.pdf_address) %>
        </div>

        <h2>Customer Order Summary</h2>
        <%# ---- One row per works order that has something RELEASED on it.
            Driven from active release notes, not from the works orders: the
            driver signs for what has actually been booked out, and the
            quantity is the released count, never the ordered one. Works
            orders on the order with nothing released yet are listed under
            the table so the sheet says on its face that it is partial.
            (This used to print every WO at its ordered quantity — so a
            300-part order with 100 released got signed for as 300, and the
            other 200 left without a release note or an invoice.) ---- %>
        <%
          released_by_wo = customer_order.delivery_release_notes
                                         .group_by(&:works_order_id)
                                         .transform_values { |rns|
                                           { accepted: rns.sum(&:quantity_accepted), rejected: rns.sum(&:quantity_rejected) }
                                         }
          order_works_orders = customer_order.works_orders.active.includes(:part).order(:number).to_a
          on_collection      = order_works_orders.select { |wo| released_by_wo.key?(wo.id) }
          not_released       = order_works_orders - on_collection
          any_rejected       = released_by_wo.values.any? { |v| v[:rejected] > 0 }
        %>
        <table class="summary-table">
          <thead>
            <tr>
              <th>Works Order</th>
              <th>Part Number</th>
              <th>Issue</th>
              <th>Description</th>
              <th>Specification</th>
              <th class="num">Ordered</th>
              <th class="num">Released</th>
              <% if any_rejected %><th class="num">Rejected</th><% end %>
            </tr>
          </thead>
          <tbody>
            <% on_collection.each do |wo| %>
              <% r = released_by_wo[wo.id] %>
              <tr>
                <td>WO<%= wo.number %></td>
                <td><%= wo.part_number %></td>
                <td><%= wo.part_issue %></td>
                <td><%= wo.part_description %></td>
                <td><%= wo.specification %></td>
                <td class="num"><%= wo.quantity %></td>
                <td class="num"><%= r[:accepted] %></td>
                <% if any_rejected %><td class="num"><%= r[:rejected] %></td><% end %>
              </tr>
            <% end %>
          </tbody>
          <tfoot>
            <tr>
              <th colspan="5" style="text-align:right;">Total</th>
              <td class="num"><%= on_collection.sum(&:quantity) %></td>
              <td class="num"><%= on_collection.sum { |wo| released_by_wo[wo.id][:accepted] } %></td>
              <% if any_rejected %><td class="num"><%= on_collection.sum { |wo| released_by_wo[wo.id][:rejected] } %></td><% end %>
            </tr>
          </tfoot>
        </table>

        <% if not_released.any? %>
          <p style="font-size:0.85em; margin-top:0.5em;">
            <strong>Not included in this collection</strong> (nothing released yet):
            <%= not_released.map { |wo| "WO#{wo.number} #{wo.part_number} (#{wo.quantity} ordered)" }.join("; ") %>.
          </p>
        <% end %>

        <table class="signature-table">
          <tbody>
            <tr><th>Name</th><td></td></tr>
            <tr><th>Signature</th><td></td></tr>
            <tr><th>Date</th><td></td></tr>
          </tbody>
        </table>
      </div>
