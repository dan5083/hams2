<style>
      body {
        font-family: sans-serif;
        font-size: 9pt;
        margin: 0;
        /* No bottom padding. @page already reserves a 1cm bottom margin on
           every sheet, so a bottom padding here is not extra whitespace —
           it is 1cm of box that has to be placed after the final block in
           the flow. That pushed .cert-footer (page-break-inside: avoid)
           onto a sheet of its own whenever the certificate ended within
           1cm of the bottom, and could also emit a trailing blank page. */
        padding: 1cm 1cm 0 1cm;
        --standard-border-width: 1pt;
        --standard-border-color: black;
        --standard-border-style: solid;
        box-sizing: border-box;
      }

      @page {
        size: A4 portrait;
        margin: 1cm;
      }

      /* ----------------------------------------------------------------
         Advice Note — single page, always starts on right/odd side
         ---------------------------------------------------------------- */
      .advice-note {
        page-break-before: right;
        page-break-after: always;
        padding: 0;
      }

      /* ----------------------------------------------------------------
         Certificate — starts on next sheet.
         body padding does not re-apply after a page break, so we add
         padding-top here to stop the logo sitting flush against the
         @page top margin.
         ---------------------------------------------------------------- */
      .certificate-page {
        page-break-before: always;
        padding: 0.8cm 0 0 0;
      }

      /* ----------------------------------------------------------------
         General layout
         ---------------------------------------------------------------- */
      .logo-header         { text-align: left; margin-bottom: 0.75rem; }
      .logo-header img     { max-width: 240px; height: auto; }

      .company-contact     { text-align: right; font-size: 7.5pt; color: #555; line-height: 1.2; }
      .company-contact a   { color: #555; text-decoration: none; }

      h1 { text-align: center; margin: 0.6rem 0; font-size: 1.2em; }
      h2 { font-size: 0.9em; margin: 0.6rem 0 0.3rem 0; font-weight: bold; }

      table { width: 100%; border-collapse: collapse; margin-bottom: 0.6rem; }
      th, td {
        border: var(--standard-border-width) var(--standard-border-style) var(--standard-border-color);
        padding: 0.3rem 0.4rem;
        vertical-align: top;
      }
      th { background-color: #f8f9fa; font-weight: bold; text-align: left; width: 30%; }

      .addresses          { table-layout: fixed; margin-bottom: 0.75rem; }
      .address            { width: 50%; vertical-align: top; padding: 0.4rem; }
      .address h2         { font-size: 0.85em; margin: 0 0 0.3rem 0; text-decoration: underline; }
      .address p          { margin: 0; line-height: 1.3; }

      .header-table       { margin-bottom: 0.75rem; }
      .detail-table       { margin-top: 0.5rem; margin-bottom: 0.75rem; }

      /* ----------------------------------------------------------------
         Advice-note order summary — one row per release note on the order
         ---------------------------------------------------------------- */
      .summary-table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 0.75rem;
        font-size: 8pt;
      }
      .summary-table th {
        width: auto;                 /* override global th { width: 30% } */
        text-align: left;
        background-color: #f1f5f9;
        font-weight: bold;
        padding: 0.3rem 0.4rem;
        border: 1pt solid #94a3b8;
        white-space: nowrap;
      }
      .summary-table td {
        padding: 0.3rem 0.4rem;
        border: 1pt solid #cbd5e1;
        vertical-align: top;
      }
      .summary-table th.num,
      .summary-table td.num { text-align: right; white-space: nowrap; }
      .summary-table tfoot th,
      .summary-table tfoot td {
        background-color: #f8f9fa;
        font-weight: bold;
      }

      .signature-table    { table-layout: fixed; margin-top: 0.75rem; }
      .signature-table th { width: 25%; }
      .signature-table td { height: 2.5rem; }

      .signature-name {
        font-family: 'Times New Roman', serif;
        font-size: 1.1em;
        font-style: italic;
        font-weight: bold;
      }

      /* ----------------------------------------------------------------
         Thickness section header
         ---------------------------------------------------------------- */
      .thickness-group-header {
        background-color: #e9ecef;
        font-weight: bold;
        font-size: 9pt;
        padding: 0.2rem 0.4rem;
        border: 1pt solid #ccc;
        margin-bottom: 0.3rem;
      }

      /* Overall combined stats bar (multi-batch only) */
      .overall-stats {
        background-color: #eff6ff;
        border: 1pt solid #bfdbfe;
        padding: 0.25rem 0.4rem;
        margin-bottom: 0.35rem;
        font-size: 8pt;
        color: #1e40af;
      }
      .overall-stats strong { color: #1d4ed8; }

      /* ----------------------------------------------------------------
         Anodic compact table
         One row per batch: Batch | Mean | Min | Max | R1...R8
         ---------------------------------------------------------------- */
      .anodic-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 8pt;
        margin-bottom: 0.5rem;
      }
      .anodic-table th {
        background-color: #f1f5f9;
        text-align: center;
        padding: 0.25rem 0.2rem;
        border: 1pt solid #94a3b8;
        font-size: 7.5pt;
        width: auto;
      }
      .anodic-table th.stat-col   { width: 6%; }
      .anodic-table th.reading-col { width: 6.5%; }
      .anodic-table td {
        text-align: center;
        padding: 0.25rem 0.2rem;
        border: 1pt solid #cbd5e1;
        vertical-align: middle;
      }
      .anodic-table td.batch-label {
        font-weight: bold;
        background-color: #eff6ff;
        color: #1d4ed8;
        white-space: nowrap;
      }
      .anodic-table td.stat-mean { font-weight: bold; color: #1d4ed8; }
      /* Stat cell that is meaningless for the row (single reading: mean,
         min and max would all just repeat R1). Rendered as a muted dash —
         reads as "n/a" to an auditor, unlike an arrow/ditto mark. */
      .anodic-table td.na { color: #94a3b8; }

      /* ----------------------------------------------------------------
         NADCAP sample-plan: batch sub-header above per-part table
         ---------------------------------------------------------------- */
      .nadcap-batch-label {
        font-size: 8pt;
        font-weight: bold;
        color: #1d4ed8;
        background-color: #eff6ff;
        border: 1pt solid #bfdbfe;
        padding: 0.25rem 0.4rem;
        margin: 0.4rem 0 0.2rem 0;
      }
      .nadcap-batch-label .stat {
        font-weight: normal;
        color: #1e3a8a;
        margin-left: 0.5rem;
      }

      /* ----------------------------------------------------------------
         ENP compact table (before / after / growth per point, per batch)
         ---------------------------------------------------------------- */
      .enp-batch-label {
        font-size: 8pt;
        font-weight: bold;
        color: #1d4ed8;
        padding: 0.15rem 0;
        margin: 0.3rem 0 0.15rem 0;
      }
      .enp-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 8pt;
        margin-bottom: 0.35rem;
      }
      .enp-table thead th {
        background-color: #f1f5f9;
        font-weight: bold;
        text-align: center;
        padding: 0.25rem 0.3rem;
        border: 1pt solid #94a3b8;
        width: auto;
      }
      .enp-table tbody td {
        text-align: center;
        padding: 0.25rem 0.3rem;
        border: 1pt solid #cbd5e1;
      }
      .enp-table tbody tr:nth-child(even) { background-color: #f8fafc; }
      .enp-growth-positive { color: #16a34a; font-weight: bold; }
      .enp-growth-negative { color: #dc2626; font-weight: bold; }

      /* Gauge info box (Lufthansa) */
      .gauge-info {
        background-color: #fffbeb;
        border: 1pt solid #fbbf24;
        padding: 0.35rem;
        margin-bottom: 0.4rem;
        font-size: 8pt;
        line-height: 1.4;
      }
      .gauge-info strong { color: #92400e; }

      /* Customer reference highlight row */
      .customer-reference-row {
        padding: 0.4rem;
        background-color: #f0f9ff;
        border: 1pt solid #bae6fd;
        margin-bottom: 0.6rem;
        font-weight: bold;
        text-align: center;
        font-size: 8.5pt;
      }

      /* ----------------------------------------------------------------
         Adhesion bend test panels
         ---------------------------------------------------------------- */
      .bend-test-table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 0.6rem;
        font-size: 9pt;
      }
      .bend-test-table th {
        background-color: #f1f5f9;
        text-align: center;
        width: 25%;
        padding: 0.3rem 0.4rem;
        border: 1pt solid #94a3b8;
        font-size: 8.5pt;
      }
      .bend-test-table td {
        text-align: center;
        padding: 0.4rem;
        border: 1pt solid #cbd5e1;
        font-weight: bold;
        font-size: 1.05em;
        color: #16a34a;
      }

      /* ----------------------------------------------------------------
         Certificate footer — statement + signature + accreditation.
         In normal flow (no fixed positioning).
         The statement and the signature that covers it must never be
         split, so .cert-signoff is the atomic unit. The accreditation
         strapline is boilerplate and is left breakable, so a certificate
         that ends very close to the bottom pushes ~2cm rather than the
         whole ~8cm block onto a new sheet.
         ---------------------------------------------------------------- */
      .cert-footer {
        margin-top: 0.75rem;
      }
      .cert-signoff {
        page-break-inside: avoid;
      }
      .statement {
        padding: 0.6rem 0.75rem;
        border: 1pt solid #ccc;
        background-color: #f8f9fa;
        margin-bottom: 0.5rem;
        font-size: 8.5pt;
      }
      .statement p { margin: 0; }
      .signature-block { text-align: center; margin-top: 0.5rem; margin-bottom: 0.5rem; }
      .company-footer {
        text-align: center;
        font-size: 8pt;
        color: #555;
        line-height: 1.4;
        border-top: 1pt solid #ddd;
        padding-top: 0.4rem;
        margin-top: 0.4rem;
      }

      /* Bare numbers, unit stated once in the header; kept on one line so a
         reading like "50.6" can't wrap onto two rows in a narrow cell. */
      .anodic-table td,
      .anodic-table th { white-space: nowrap; }
    </style>
