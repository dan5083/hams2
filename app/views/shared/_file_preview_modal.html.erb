<%# app/views/shared/_file_preview_modal.html.erb
    Full-screen preview for a document thumbnail (drawings on the works
    order page, the customer PO on the order page). Any element carrying
    data-part-file-preview opens it; the element's data attributes supply
    the preview url, kind (pdf|image), title and download url. Delegated
    listeners on document, bound once, so it survives Turbo morphs. %>
  <div id="part-file-modal" class="fixed inset-0 z-50 hidden" role="dialog" aria-modal="true" aria-labelledby="part-file-modal-title">
    <div class="absolute inset-0" style="background: rgba(17, 24, 39, 0.85);" data-modal-close></div>

    <div class="relative flex flex-col h-full w-full max-w-6xl mx-auto p-4">
      <div class="flex items-center justify-between mb-3 text-white">
        <h3 id="part-file-modal-title" class="text-sm font-medium truncate pr-4"></h3>
        <div class="flex items-center space-x-2 flex-shrink-0">
          <a id="part-file-modal-download" href="#"
             class="inline-flex items-center px-3 py-1.5 text-sm font-medium rounded-md bg-white text-gray-800 hover:bg-gray-100">
            Download
          </a>
          <button type="button" data-modal-close
                  class="inline-flex items-center px-3 py-1.5 text-sm font-medium rounded-md bg-gray-700 text-white hover:bg-gray-600"
                  aria-label="Close">
            Close
          </button>
        </div>
      </div>

      <div class="flex-1 min-h-0 flex items-center justify-center">
        <img id="part-file-modal-image" src="" alt="" class="hidden max-w-full max-h-full object-contain rounded shadow-lg bg-white">
        <iframe id="part-file-modal-frame" src="about:blank" title="Drawing" class="hidden w-full h-full rounded shadow-lg bg-white"></iframe>
      </div>
    </div>
  </div>

  <style>
    .part-doc-thumb { position: relative; transition: transform 150ms ease, box-shadow 150ms ease; cursor: zoom-in; }
    .part-doc-thumb:hover,
    .part-doc-thumb:focus-visible {
      transform: scale(1.15);
      z-index: 30;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.25);
    }
  </style>

  <script>
    (function () {
      // Delegated listeners on document survive Turbo morphs; the flag stops
      // them being bound twice when the page is re-rendered.
      if (window.__partFileModalBound) return;
      window.__partFileModalBound = true;

      function els() {
        return {
          modal: document.getElementById('part-file-modal'),
          title: document.getElementById('part-file-modal-title'),
          download: document.getElementById('part-file-modal-download'),
          image: document.getElementById('part-file-modal-image'),
          frame: document.getElementById('part-file-modal-frame')
        };
      }

      function openModal(button) {
        var e = els();
        if (!e.modal) return;

        var url = button.dataset.previewUrl;
        var kind = button.dataset.previewKind;

        e.title.textContent = button.dataset.previewTitle || '';
        e.download.href = button.dataset.downloadUrl || '#';

        if (kind === 'pdf') {
          e.image.classList.add('hidden');
          e.image.src = '';
          e.frame.src = url;
          e.frame.classList.remove('hidden');
        } else {
          e.frame.classList.add('hidden');
          e.frame.src = 'about:blank';
          e.image.src = url;
          e.image.alt = button.dataset.previewTitle || '';
          e.image.classList.remove('hidden');
        }

        e.modal.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      }

      function closeModal() {
        var e = els();
        if (!e.modal || e.modal.classList.contains('hidden')) return;

        e.modal.classList.add('hidden');
        e.image.src = '';
        e.frame.src = 'about:blank';
        document.body.style.overflow = '';
      }

      document.addEventListener('click', function (event) {
        var thumb = event.target.closest('[data-part-file-preview]');
        if (thumb) {
          event.preventDefault();
          openModal(thumb);
          return;
        }
        if (event.target.closest('[data-modal-close]')) {
          closeModal();
        }
      });

      document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape') closeModal();
      });
    })();
  </script>
