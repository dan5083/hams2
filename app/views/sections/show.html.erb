<%# app/views/sections/show.html.erb %>
<div class="container mx-auto px-4 py-6">

  <!-- Section tabs -->
  <div class="flex flex-wrap gap-2 mb-6">
    <% ShopSectionBoard::SECTIONS.each do |key, label| %>
      <%= link_to label, section_path(key),
          class: "px-4 py-2 rounded-full text-sm font-bold #{key == @section ? 'bg-blue-600 text-white' : 'bg-white text-gray-700 shadow hover:bg-gray-100'}" %>
    <% end %>
  </div>

  <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-6"><%= @title %></h1>

  <% if @section == "enp" %>
    <%= render "enp" %>
  <% elsif @section == "shop1_anodisers" %>
    <% insp = @board.masking_inspection_queue("shop1") %>
    <% if insp.any? %>
      <h2 class="text-lg font-bold text-fuchsia-800 mb-3">⚡ Lacquered — inspect masking before jigging</h2>
      <%= render "masking_inspection", rows: insp %>
      <h2 class="text-lg font-bold text-gray-700 mt-8 mb-3">Jigged — ready for the vat</h2>
    <% end %>
    <%= render "anodisers", shop: "shop1" %>
  <% elsif @section == "shop1_jiggers" %>
    <% insp = @board.masking_inspection_queue("shop1") %>
    <% if insp.any? %>
      <h2 class="text-lg font-bold text-fuchsia-800 mb-3">⚡ Lacquered — inspect masking before jigging</h2>
      <%= render "masking_inspection", rows: insp %>
      <h2 class="text-lg font-bold text-gray-700 mt-8 mb-3">Jigging queue</h2>
    <% end %>
    <%= render "jiggers", shop: "shop1" %>
  <% elsif %w[shop2 factory2 chromic].include?(@section) %>
    <%# These shops jig their own work, so one page: jigging on the left,
        the vat on the right. Stacks on anything narrower than xl. %>
    <% insp = @board.masking_inspection_queue(@section) %>
    <% if insp.any? %>
      <h2 class="text-lg font-bold text-fuchsia-800 mb-3">⚡ Lacquered — inspect masking before jigging</h2>
      <%= render "masking_inspection", rows: insp %>
    <% end %>
    <div class="grid grid-cols-1 xl:grid-cols-2 gap-6 <%= 'mt-8' if insp.any? %>">
      <div class="min-w-0 overflow-x-auto">
        <h2 class="text-lg font-bold text-gray-700 mb-3">Jigging queue</h2>
        <%= render "jiggers", shop: @section %>
      </div>
      <div class="min-w-0 overflow-x-auto">
        <h2 class="text-lg font-bold text-gray-700 mb-3">
          Jigged — ready for <%= @section == "chromic" ? "Vat 10" : "the vat" %>
        </h2>
        <%= render "anodisers", shop: @section %>
      </div>
    </div>
  <% elsif @section == "lacquering" %>
    <%= render "lacquering" %>
  <% elsif @section == "contract_review" %>
    <%= render "contract_review" %>
  <% elsif @section == "chem_conv" %>
    <%= render "chem_conv" %>
  <% else %>
    <%# A key in SECTIONS with no branch here would otherwise render a silent
        blank page. Fail loudly instead. %>
    <div class="bg-red-50 border border-red-200 rounded-lg p-6 text-red-700 font-medium">
      Section "<%= @section %>" is routed but has no view branch — add it to sections/show.html.erb.
    </div>
  <% end %>
</div>
